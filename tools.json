          },
          "parent" : {
            "type" : "string",
            "description" : "node id (nN) to append under; omit to append at the root"
          },
          "before" : {
            "type" : "string",
            "description" : "node id (nN) of the existing sibling node to insert before"
          },
          "node" : {
            "type" : "string",
            "description" : "node id (nN) of a text-children node: h1, h2, h3, text, span"
          },
          "attr" : {
            "type" : "string",
