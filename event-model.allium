-- allium: 3
-- event-model.allium

-- Scope: Authoring of Event Models via a CLI tool (create & update)
-- Includes:
--   - Canonical model: EventModel, Timeline, Swimlane, Slice, Element
--     (Command / Event / ReadModel / Screen / Automation), Field,
--     Specification (Given / When / Then)
--   - Single-source Elements, referenced from slices across timelines and named
--     uniquely within their model (compared case-insensitively), so an element's
--     name identifies exactly one element
--   - Field names, which are names like every other name in the model - unique
--     within their field list, compared case-insensitively - but referenced BY
--     NAME rather than by identity, making a field name the model's one textual
--     reference
--   - Renaming every named thing - timeline, swimlane, slice, specification,
--     element, error step and field - each keeping the model's references
--     consistent, which for a field means carrying the new name through every
--     derivation, override, example and layout node that names it
--   - Information completeness / field provenance: every field on an element
--     traces to a source (carried from an incoming connection's source element,
--     derived from named source fields, or introduced via an operator override),
--     rolled up into a derived per-element completeness verdict
--   - Screen layouts: a screen element may carry a wireframe, a tree of layout
--     nodes (rows, columns, headings, inputs, actions, content) addressed by
--     stable node ids and referring only to that screen's own fields. A
--     wireframe says what a screen presents and accepts, never how it is drawn.
--   - Import & export of the eventmodeling.schema.json interchange format,
--     round-tripped at the semantic level
--   - A live, read-only change stream a frontend subscribes to in order to
--     visualise the model as it is edited (snapshot on connect, then deltas)
--   - A read-only structural query language over the model: follow relations
--     from a root entity kind and return the reachable entities (optionally
--     carrying the association traversed), so the model's structure can be
--     explored in text without dumping it. The relational counterpart to name
--     resolution.
-- Excludes:
--   - Canvas / whiteboard format (an external LLM agent drives this CLI to
--     recreate canvas models; no native canvas parser)
--   - Visual presentation: pixel layout, positions, colours, typography, and
--     rendering a wireframe to HTML/SVG (a separate consumer's concern)
--   - Durable storage of the model between process lifetimes: the model's
--     existence is given to this specification, not authored by it
--   - LLM tool manifests derived from this surface, and the harnesses that
--     consume them (delivery mechanism, not domain)
--   - Terminal output rendering, and the mechanical parsing of command-line
--     text (delivery mechanism, not domain). The query language's own surface
--     (its roots, relations, stages and projection) is in scope; see ModelQuery.
-- Interchange format:
--   github.com/dilgerma/event-modeling-spec  eventmodeling.schema.json

-- ---------------------------------------------------------------------------
-- Canonical model
-- ---------------------------------------------------------------------------

entity EventModel {
    name: String

    -- A model owns its timelines and a single-source registry of elements.
    timelines: Timeline with model = this
    swimlanes: Swimlane with model = this
    elements: Element with model = this
    connections: Connection with model = this
    subscriptions: Subscription with model = this
}

-- A frontend connected to this model's live change stream. One instance per
-- connected client; many may be active at once. Existence = connected; the
-- subscription is removed on disconnect (see Unsubscribe).
entity Subscription {
    model: EventModel
}

-- A consistency boundary (the Event Modeling "swimlane") that cuts across
-- timelines. Maps to the schema's element.aggregate on export/import.
entity Swimlane {
    model: EventModel
    name: String
    -- Author-controlled display order within the model, so a frontend renders
    -- swimlanes top-to-bottom as the author arranged them. A sort key only:
    -- non-unique and non-contiguous, ties broken by creation order. Carries no
    -- eventmodeling.schema.json representation (see SchemaCodec dropped fields).
    index: Integer
}

-- A named flow. Maps to the schema's slice.context: every slice in this
-- timeline exports with context = title, and slices are grouped back into
-- timelines by that field on import.
entity Timeline {
    model: EventModel
    title: String

    slices: Slice with timeline = this
}

entity Slice {
    timeline: Timeline
    title: String
    index: Integer
    slice_type: state_change | state_view | automation
    -- 'informational' tags a pure story-telling slice: not acted on, exempt
    -- from composition rules, and dropped on schema export. It is a status (not
    -- a type) so the slice still carries its pattern type while being tagged.
    status: created | in_progress | done | informational

    -- Elements that appear in this slice (single-source, referenced).
    placements: ElementPlacement with slice = this
    specifications: Specification with slice = this

    -- Placements grouped by element type, for the composition rules.
    commands: placements where element.element_type = command
    events: placements where element.element_type = event
    read_models: placements where element.element_type = read_model
    screens: placements where element.element_type = screen
    automations: placements where element.element_type = automation

    -- Export-readiness: the strict composition a slice must satisfy before it
    -- can be exported. Need not hold during authoring. Slices with status
    -- 'informational' are excluded from export entirely, regardless of this
    -- predicate (see SchemaCodec.ExportRequiresComplete).
    is_complete:
        (slice_type = state_change and commands.count = 1) or
        (slice_type = state_view and read_models.count = 1) or
        (slice_type = automation and commands.count = 1 and automations.count = 1)
}

-- A reference to a single-source Element from within a Slice.
-- The same Element may be placed in many slices and many timelines.
-- On export, each placement becomes an embedded schema Element sharing a groupId.
entity ElementPlacement {
    slice: Slice
    element: Element
    -- Author-controlled display order of this placement within its slice, so a
    -- frontend renders placements in the order the author arranged them. Unique
    -- within a slice as produced by every operation that sets it: PlaceElement
    -- appends one past the highest index (or 0 when it is the first), and
    -- ReorderPlacement renumbers the whole slice 0..n-1. Gaps appear after
    -- removals (RemovePlacement leaves the survivors' indices as they were).
    -- Still a sort key only, read with a creation-order tiebreak that is now
    -- merely defensive: the indices in play are already distinct.
    index: Integer
}

entity Element {
    model: EventModel
    name: String                 -- identity for referencing; unique within its
                                 -- model, compared case-insensitively and ignoring
                                 -- surrounding whitespace, so it names exactly one
                                 -- element (see invariant ElementNameUnique)
    element_type: command | event | read_model | screen | automation
    context: internal | external

    -- A field list holds no two fields under one name, compared case-insensitively
    -- like every other name in the model (see invariant FieldNameUnique). Names
    -- are also the model's one TEXTUAL form of reference: a connection derivation,
    -- a field-origin override, a step example and a screen's layout all name a
    -- field rather than pointing at one, which is why renaming a field has a
    -- cascade where renaming an element does not (see RenameField).
    fields: List<Field>

    -- The consistency boundary (aggregate) this element belongs to.
    -- Maps to the schema's element.aggregate. Optional: UI elements (screens)
    -- typically sit outside any consistency boundary.
    swimlane: Swimlane?

    -- A screen element may point at an external mockup (image URL or Figma
    -- link), shown instead of - or alongside - a layout tree.
    image_url: String?

    -- A screen's layout tree (see WireframeNode). Absent until its first node is
    -- added, and cleared to null once the whole tree is removed - the key is then
    -- present with a null value, which is what the change stream carries. Only
    -- screens carry one.
    wireframe: WireframeNode?

    -- Reverse references, walked by cascade-on-delete.
    placements: ElementPlacement with element = this
    outgoing: Connection with from = this
    incoming: Connection with to = this

    -- Operator overrides for fields that are legitimately introduced on this
    -- element rather than sourced from an incoming connection (user input at a
    -- screen, generated, or supplied by an external system). One per such field.
    field_origins: List<FieldOrigin>

    -- Information completeness (STRICT field scope): every field this element
    -- declares must be SOURCED in exactly one of three ways. The verdict is the
    -- ELEMENT-level roll-up: it takes the union across ALL incoming connections
    -- plus this element's field_origins. A read model fed by several events is
    -- complete when, between all its inbound connections and its overrides,
    -- every one of its fields is accounted for; no single connection is required
    -- to source every field. Derivation validity (target_field is this field,
    -- source_fields all exist on that connection's `from` element) is folded in:
    -- an invalid or orphaned derivation simply fails to source its field and so
    -- leaves the element incomplete, rather than tripping a hard invariant. A
    -- field is sourced iff:
    --   CARRIED    - some incoming connection's `from` element has a field with
    --                the same name; or
    --   DERIVED    - some incoming connection carries a FieldDerivation naming
    --                this field as its target, and every one of that
    --                derivation's source_fields exists on that connection's
    --                `from` element (one source field with a different name is a
    --                rename; many is an aggregation; the transform is opaque); or
    --   INTRODUCED - this element carries a FieldOrigin override for this field.
    is_information_complete:
        fields.all(f =>
            incoming.any(c => c.from.fields.any(ff => same_name(ff.name, f.name)))
            or incoming.any(c => c.derivations.any(d =>
                same_name(d.target_field, f.name)
                and d.source_fields.all(src =>
                    c.from.fields.any(sf => same_name(sf.name, src)))))
            or field_origins.any(o => same_name(o.field, f.name)))
}

-- An explicit, directed wiring between two single-source Elements.
-- Maps to the schema's dependencies: an OUTBOUND dependency on `from`
-- and the matching INBOUND dependency on `to` are both derived from this.
entity Connection {
    model: EventModel
    from: Element
    to: Element

    -- Explicit, connection-local field provenance: how named fields on the `to`
    -- element are derived from fields on the `from` element across THIS wiring.
    -- Each derivation names a target field and the source fields it draws from
    -- (rename when one, aggregation when many); the transform is a black box.
    -- This is only one connection's contribution; the complete/incomplete
    -- verdict is rolled up at the element (see Element.is_information_complete).
    derivations: List<FieldDerivation>
}

value Field {
    name: String
    type: string | boolean | double | decimal | long | custom | date | date_time | uuid | int
    optional: Boolean
    cardinality: single | list
    subfields: List<Field>
}

-- An explicit derivation recorded on a Connection: the target field (on the
-- connection's `to` element) is produced from one or more source fields (on the
-- connection's `from` element). One source_field naming a differently-named
-- target is a rename; several is an aggregation. The transform that combines the
-- source fields (sum, concat, ...) is a black box: only WHICH source fields are
-- recorded, never HOW they are combined.
value FieldDerivation {
    target_field: String
    source_fields: List<String>
}

-- An operator override declaring that a named field on an element is
-- legitimately introduced rather than sourced from upstream: typed by the user
-- at a screen, generated by the system, or supplied by an external system.
value FieldOrigin {
    field: String
    origin: user_input | generated | external
}

-- Screen layout vocabulary (the wireframe DSL) ------------------------------

-- The tags a layout node may carry, by role:
--   layout     - canvas (the node a layout is rooted at), row, col, divider
--   typography - h1, h2, h3, text, span (those that carry text content)
--   input      - input, textarea, dropdown, checkbox, toggle
--   action     - button, icon-button
--   content    - link, image, icon, alert
enum WireframeTag {
    canvas | row | col | divider
    h1 | h2 | h3 | text | span
    input | textarea | dropdown | checkbox | toggle
    button | `icon-button`
    link | image | icon | alert
}

-- The attributes a node may carry, besides its node id. Which of them a given
-- tag admits, which are mandatory for it, and the value type and allowed set
-- each takes, is that tag's schema: the full per-tag matrix is tabulated in
-- doc/wireframe-dsl.md. Values are always expressible as text (a flag as
-- "true"/"false", a choice as its name, a list comma-separated), which is how an
-- operator supplies them.
enum WireframeAttributeName {
    align | gap | width | tone | type | aspect | size | variant
    name | label | placeholder | alt | `aria-label` | options | text | icon
    required | default | disabled | `field-name` | `command-input`
}

-- One attribute set on a layout node.
value WireframeAttribute {
    name: WireframeAttributeName
    value: String
}

-- One node of a screen's layout tree: a tag, that tag's attributes, a text
-- content (only where the tag carries one), and child nodes (only where the tag
-- is a container).
--
-- node_id is a stable address ("n1", "n2", ...) allocated when the node is
-- created: one past the highest numeric id currently in the tree. Removing a
-- node neither shifts nor changes any surviving node's id, so an address read
-- once stays valid across unrelated edits; a removed node's number may be reused
-- if it was the highest in the tree. Node ids address nodes for editing only;
-- the rest of the canonical model knows nothing of them.
value WireframeNode {
    node_id: String
    tag: WireframeTag

    attributes: List<WireframeAttribute>

    -- The node's text content, where its tag carries one.
    text: String?

    children: List<WireframeNode>
}

entity Specification {
    slice: Slice
    title: String

    steps: SpecStep with spec = this
    given_steps: steps where clause = given_step
    when_steps: steps where clause = when_step
    then_steps: steps where clause = then_step

    -- Singletons used by the composition and export-readiness rules.
    when_commands: steps where clause = when_step and element.element_type = command
    then_read_models: steps where clause = then_step and element.element_type = read_model

    -- Export-readiness: the singleton each shape requires. Need not hold during
    -- authoring (steps are added incrementally); enforced only at export.
    is_complete:
        ((slice.slice_type = state_change or slice.slice_type = automation) and when_commands.count = 1) or
        (slice.slice_type = state_view and then_read_models.count = 1)
}

-- A single Given/When/Then step. References the model Element it asserts about
-- (single-source link; an error step refers to no element). The element's type gives the
-- schema step type (event -> SPEC_EVENT, command -> SPEC_COMMAND,
-- read_model -> SPEC_READMODEL); an error step maps to SPEC_ERROR.
entity SpecStep {
    spec: Specification
    clause: given_step | when_step | then_step
    index: Integer

    element: Element?
    is_error: Boolean
    error_name: String?

    -- expectEmptyList in the schema: a then-step asserting an empty result.
    expect_empty: Boolean

    -- Concrete example values for the referenced element's fields (test data).
    examples: List<Example>
}

value Example {
    field_name: String
    field_value: String
}

-- ---------------------------------------------------------------------------
-- Config
-- ---------------------------------------------------------------------------

config {
    -- How many candidates name resolution returns per queried name, and the
    -- size of the near-miss suggestion set as well (NameResolution). The bound
    -- is what keeps a resolve response a function of the number of names asked
    -- about rather than of the size of the model.
    resolve_candidate_cap: Integer = 5
}

-- ---------------------------------------------------------------------------
-- Authoring operations
-- ---------------------------------------------------------------------------

-- Timelines ----------------------------------------------------------------

-- Three conventions hold across the operations below.
--
-- Optional pre-assigned identity: every operation that creates an entity accepts
-- an optional `id`, so a caller can name an entity before it exists. Identity is
-- one sequence shared by every entity of a model, so an id already in use by any
-- entity of any type is rejected rather than silently overwriting or colliding;
-- an omitted id is allocated by the model. Identity is otherwise opaque to this
-- specification (see the note under ModelChangeStream).
--
-- Non-blank names: every operation taking a name, title or field name rejects a
-- blank one, so no entity can be created or renamed to an unusable, unnameable
-- state. The guards below state this through non_blank, a black box function:
-- true when the string has at least one non-whitespace character.
--
-- Unique names: a name identifies exactly one entity within the smallest
-- container in which it has to do so. Two names are the same when they are equal
-- apart from case and surrounding whitespace; the guards below state this through
-- same_name(a, b), a black box function: true when `a` and `b` are that same
-- string. An element's name, a timeline's title and a swimlane's name are unique
-- within their model; a slice's title is unique within its timeline; a
-- specification's title within its slice; a field's name within its field list
-- (the invariants in the Invariants section state each, with its reason). Every
-- operation that creates or renames one of these rejects a collision instead of
-- allowing a second entity under a name already in use, and the rejection names
-- the entity already holding the name (its id, and its element or slice type where it carries one), so
-- a caller reuses or places what exists rather than inventing a near-duplicate
-- name. AddField is the one exception, and deliberately so: it is a field editor
-- keyed on the name, so a name it already finds is UPDATED in place, while
-- RenameField - which moves an existing field rather than editing one - rejects
-- the collision (see invariant FieldNameUnique). Where a name is unique
-- within a model, two models may still each hold it.

rule CreateTimeline {
    when: CreateTimeline(model, title, id?)
    requires: non_blank(title)
    -- A second timeline under a title the model already uses is rejected (see
    -- invariant TimelineTitleUnique). Beyond addressing it, the title is a group
    -- key of the interchange format: slices export their timeline as the bare
    -- `context` string and import groups them back by it.
    requires: not model.timelines.any(t => same_name(t.title, title))
    ensures: Timeline.created(model: model, title: title)
}

rule RenameTimeline {
    when: RenameTimeline(timeline, new_title)
    requires: non_blank(new_title)
    requires: not timeline.model.timelines.any(t =>
        t != timeline and same_name(t.title, new_title))
    ensures: timeline.title = new_title
}

-- Swimlanes -----------------------------------------------------------------

rule CreateSwimlane {
    when: CreateSwimlane(model, name, index, id?)
    requires: non_blank(name)
    -- A second swimlane under a name the model already uses is rejected (see
    -- invariant SwimlaneNameUnique). The name is also the interchange format's
    -- only handle on a swimlane (element.aggregate), so a repeat would merge the
    -- two on import.
    requires: not model.swimlanes.any(l => same_name(l.name, name))
    ensures: Swimlane.created(model: model, name: name, index: index)
}

rule RenameSwimlane {
    when: RenameSwimlane(lane, new_name)
    requires: non_blank(new_name)
    requires: not lane.model.swimlanes.any(other =>
        other != lane and same_name(other.name, new_name))
    ensures: lane.name = new_name
}

rule ReorderSwimlane {
    when: ReorderSwimlane(lane, new_index)
    ensures: lane.index = new_index
}

rule RenameElement {
    when: RenameElement(element, new_name)
    requires: non_blank(new_name)
    -- The new name must still identify exactly one element of the model (see
    -- invariant ElementNameUnique): renaming an element onto the name another
    -- element holds is rejected. Renaming an element to the name it already has
    -- is no collision.
    requires: not element.model.elements.any(e =>
        e != element and same_name(e.name, new_name))
    ensures: element.name = new_name
}

-- Deleting a swimlane unassigns it from any elements, then removes it.
rule DeleteSwimlaneCascades {
    when: DeleteSwimlane(lane)
    ensures:
        for e in Elements where swimlane = lane:
            e.swimlane = null
    ensures: not exists lane
}

-- Slices --------------------------------------------------------------------

rule AddSlice {
    when: AddSlice(timeline, title, slice_type, index, id?)
    requires: non_blank(title)
    -- The title must be unique within this timeline (see invariant
    -- SliceTitleUnique); the same title in another timeline is a different slice
    -- and stays legal.
    requires: not timeline.slices.any(s => same_name(s.title, title))
    ensures: Slice.created(
        timeline: timeline,
        title: title,
        slice_type: slice_type,
        index: index,
        status: created
    )
}

-- Rename a slice's title. The title is unique within the smallest container that
-- has to tell one slice from another - its timeline (see invariant
-- SliceTitleUnique) - and, like a timeline's or a swimlane's, nothing points at
-- it: a slice is addressed by identity wherever it is referenced, and the title
-- reaches another boundary only as a derived breadcrumb (see
-- NameResolution.CandidateDisambiguation), so there is nothing to cascade.
rule RenameSlice {
    when: RenameSlice(slice, new_title)
    requires: non_blank(new_title)
    requires: not slice.timeline.slices.any(other =>
        other != slice and same_name(other.title, new_title))
    ensures: slice.title = new_title
}

rule ReorderSlice {
    when: ReorderSlice(slice, new_index)
    ensures: slice.index = new_index
}

-- Reorder the placement of `element` within `slice` with a single relative move.
-- `move` carries exactly one selector:
--   position: front   - move to the head of the slice's placements
--   position: back    - move to the tail
--   before: <element> - move immediately before that element's placement
--   after:  <element> - move immediately after it
-- `before`/`after` must name an element placed in the same slice. Two black-box
-- collection helpers express the reindexing:
--   reposition(list, element, move): returns `list` ordered with `element`'s
--     placement at the head, at the tail, or immediately before/after the anchor
--     placement; every other placement keeps its relative order.
--   index_in(list, placement): the 0-based index of `placement` in `list`.
-- An index is a sort key only - non-contiguous once placements have been
-- removed - so a relative move cannot be expressed by nudging a single integer.
-- EVERY placement in the slice is renumbered instead: after the move the slice's
-- placements carry 0..n-1, their new display order.
-- A placement is addressed by (slice, element), its natural key (see invariant
-- PlacementElementUnique), so no placement id is used to address one.
rule ReorderPlacement {
    when: ReorderPlacement(slice, element, move)
    -- The target must be placed in the slice; a before/after anchor must name a
    -- different element that is placed in the same slice. An anchor equal to the
    -- moved element has nothing left to insert next to once the moved placement
    -- is lifted out of the slice.
    requires: slice.placements.any(p => p.element = element)
    requires: move.before = null or (
        move.before != element
        and slice.placements.any(p => p.element = move.before))
    requires: move.after = null or (
        move.after != element
        and slice.placements.any(p => p.element = move.after))
    let order = reposition(slice.placements, element, move)
    ensures:
        for p in order:
            p.index = index_in(order, p)
}

rule SetSliceStatus {
    when: SetSliceStatus(slice, new_status)
    ensures: slice.status = new_status
}

rule SetSliceType {
    when: SetSliceType(slice, new_slice_type)
    ensures: slice.slice_type = new_slice_type
}

-- Elements ------------------------------------------------------------------

rule CreateElement {
    when: CreateElement(model, name, element_type, id?)
    requires: non_blank(name)
    -- A second element under a name the model already uses is rejected rather
    -- than allowed to exist (see invariant ElementNameUnique). The name is how
    -- every operation that takes one addresses an element, so an element sharing
    -- its name with another is one no caller can address unambiguously.
    requires: not model.elements.any(e => same_name(e.name, name))
    ensures: Element.created(
        model: model,
        name: name,
        element_type: element_type,
        context: internal
    )
}

-- Field editing touches a single field by name, preserving the rest of the
-- element's field list (subfields included). The black-box collection helpers
-- below express the shared key-based semantics used throughout the authoring
-- operations. A key here is always a NAME - a field's own name, a field-origin's
-- field, a derivation's target_field, an example's field_name - and keys are
-- compared by the model's name equality, so two keys are the same key when they
-- are the same name (same_name), exactly as two entities' names are. That single
-- equality is what makes a field list hold at most one entry per name, and what
-- makes a field REFERENCE resolve under the same equality the declaration does
-- (see invariant FieldNameUnique).
--   upsert_by(list, item, key_of): returns the list with `item` replacing any
--     existing entry whose key is the same name as item's key, or with `item`
--     added when no entry matches; every other entry is preserved.
--   upsert_field(list, parent_field?, item): AddField's keyed edit at either
--     level - `upsert_by(list, item, f => f.name)` when no parent is named,
--     otherwise `upsert_by` over the subfields of the field whose name is
--     `parent_field`, with every other field left untouched.
--   remove_by(list, key, key_of): returns the list with every entry whose key is
--     the same name as `key` removed; every other entry is preserved.
--   next_index(list): the sort key that places a new entry after every existing
--     one - one past the highest key in the list, or 0 for an empty list. Order
--     is a sort key only, so this merely makes the new entry render last until
--     the operator reorders it.
--   field_names_unique(fields): true when no field list in the tree rooted at
--     `fields` - the element's own list, and any field's subfields, however deep
--     - holds two fields under one name. The predicate is recursive because a
--     field list is a tree, and because the whole tree is installed at once by
--     the import path (see invariant FieldNameUnique).
--
-- RenameField's cascade needs three more, each respelling a name where it is
-- held rather than looked up:
--   rename_keyed(list, old_name, new_name, key_of): returns the list with the key
--     of every entry that is the same name as `old_name` respelled to `new_name`;
--     every other entry, and every other part of a matched entry, is preserved.
--     Respelling a key is what renames a field, because the key IS the name for
--     an element's fields (f => f.name), a field-origin override (o => o.field),
--     a step example (e => e.field_name) and a derivation's target (d =>
--     d.target_field) alike.
--   rename_source_fields(derivations, old_name, new_name): rename_keyed one level
--     deeper - every entry of every derivation's source_fields that is the same
--     name as `old_name` respelled to `new_name`, with the derivations and their
--     target_fields otherwise preserved. A source_fields entry names a field of
--     the connection's `from` element, which is why a rename on an element
--     reaches this list only through that element's outgoing connections.
--   rename_layout_field(tree, old_name, new_name): returns a layout tree with the
--     value of every field-name attribute that is the same name as `old_name`
--     respelled to `new_name`; the tree's structure, its node ids and every other
--     attribute are untouched, and a null tree (a screen carrying no layout) comes
--     back null.

-- Upsert `field` into the element's fields, replacing any existing field whose
-- name is the same name, or adding it when none matches; the rest of the list is
-- preserved. Because the key is the name, this is also how an existing field's
-- type, optionality and cardinality are edited: adding a field under a name the
-- element already carries UPDATES that field rather than colliding with it. A
-- field list carries at most one entry per name - the key this upsert and
-- RemoveField address an entry by - so a list holding two of a name is not a
-- state the surface can produce, and a document whose fields repeat one is
-- rejected on import rather than installed (see invariant FieldNameUnique, which
-- states that and the deliberate contrast with RenameField).
-- With `parent_field`, the field is upserted into THAT field's subfields instead.
-- A Field list is recursive while an operation's arguments are not, so the tree is
-- edited one level per call: `parent_field` names a field of the element itself,
-- and a name the element's own fields do not carry is rejected rather than
-- inventing the level to nest under.
rule AddField {
    when: AddField(element, field, parent_field?)
    requires: non_blank(field.name)
    requires: parent_field = null or element.fields.any(f => same_name(f.name, parent_field))
    ensures: element.fields = upsert_field(element.fields, parent_field, field)
}

-- Remove the field named `name` from the element's fields; the rest is preserved.
-- `name` is matched by name equality, and a field list holds at most one entry
-- under a name (see invariant FieldNameUnique), so at most one field is removed.
-- A name the element's stored layout still names cannot be removed: the guard is
-- on the removal itself, not on every field edit whose proposed state fails to
-- resolve, so unrelated field edits are never blocked by the layout. Removal is
-- the one field edit that can destroy a reference, which is why the layout guard
-- lives here; a rename moves the reference along with the field instead of
-- stranding it (see RenameField).
rule RemoveField {
    when: RemoveField(element, name)
    requires: not (element.fields.any(f => same_name(f.name, name))
                   and field_referenced_by_layout(element, name))
    ensures: element.fields = remove_by(element.fields, name, f => f.name)
}

-- Rename the field named `name` on `element` to `new_name`, carrying every
-- reference to it along. A field name is the model's ONE textual reference: a
-- derivation names the field it produces and the fields it draws from, a
-- field-origin override names the field it introduces, a step example names the
-- field it populates, and a layout node names the field it presents or accepts.
-- This is therefore the one rename in the model with something to cascade - every
-- other rename changes a name nothing points at (see the renames note below) -
-- and it rewrites all of the reference sites in the same operation, so no
-- reference is ever left dangling by a rename:
--   * the declaration itself, in the element's fields;
--   * the element's own field-origin override for it, keyed by field name;
--   * every derivation on an INCOMING connection naming it as the target_field;
--   * every derivation on an OUTGOING connection naming it among source_fields;
--   * every example on a step that asserts about this element, keyed by
--     field_name;
--   * every field-name attribute value in the element's own layout, when it has
--     one, so WireframeReferencesResolve keeps holding across the rename.
-- The two sides of a connection are distinct and are not interchangeable: a
-- derivation's target_field names a field of the connection's `to` element, while
-- its source_fields name fields of its `from` element. Renaming a field on this
-- element therefore rewrites the target side of the connections that point AT it
-- and the source side of the connections that leave it, and never the far side,
-- which names a field of the element at the other end.
-- A name the element's fields do not carry is rejected rather than a silent
-- no-op, and the new name must not be one another field of the same list already
-- holds: like RemoveField, this operation moves an existing field, so a collision
-- would silently destroy the sibling holding that name. That is the deliberate
-- contrast with AddField, which upserts because it is how a field is edited (see
-- invariant FieldNameUnique). Renaming a field to the name it already holds is no
-- collision; because names are compared case-insensitively, a respelling that
-- changes only case or surrounding whitespace is exactly that case, and it
-- cascades like any other rename - every reference follows the declaration to the
-- new spelling.
-- Subfields are not addressed here: like RemoveField, this operation takes one
-- name per call and reaches the element's own field list only, so the tree is
-- edited one level at a time and a nesting level is not invented to search in.
rule RenameField {
    when: RenameField(element, name, new_name)
    requires: non_blank(new_name)
    requires: element.fields.any(f => same_name(f.name, name))
    requires: not element.fields.any(f =>
        not same_name(f.name, name) and same_name(f.name, new_name))
    ensures: element.fields = rename_keyed(element.fields, name, new_name, f => f.name)
    ensures: element.field_origins = rename_keyed(element.field_origins, name, new_name, o => o.field)
    ensures:
        for c in element.incoming:
            c.derivations = rename_keyed(c.derivations, name, new_name, d => d.target_field)
    ensures:
        for c in element.outgoing:
            c.derivations = rename_source_fields(c.derivations, name, new_name)
    ensures:
        for st in SpecSteps where st.element = element:
            st.examples = rename_keyed(st.examples, name, new_name, e => e.field_name)
    ensures: element.wireframe = rename_layout_field(element.wireframe, name, new_name)
}

rule SetElementContext {
    when: SetElementContext(element, new_context)
    ensures: element.context = new_context
}

rule AssignSwimlane {
    when: AssignSwimlane(element, lane)
    ensures: element.swimlane = lane
}

rule SetImageUrl {
    when: SetImageUrl(element, url)
    ensures: element.image_url = url
}

-- Field-origin overrides (the operator's declaration of which fields are
-- legitimately introduced here) are edited one entry at a time, keyed by the
-- field name the override applies to.

-- Upsert the override {field, origin} into the element's field-origins,
-- replacing any existing entry for the same field name; the rest is preserved.
rule AddFieldOrigin {
    when: AddFieldOrigin(element, field, origin)
    requires: non_blank(field)
    let entry = FieldOrigin{ field: field, origin: origin }
    ensures: element.field_origins = upsert_by(element.field_origins, entry, o => o.field)
}

-- Remove the field-origin override for `field` name; the rest is preserved.
rule RemoveFieldOrigin {
    when: RemoveFieldOrigin(element, field)
    ensures: element.field_origins = remove_by(element.field_origins, field, o => o.field)
}

-- Placements ----------------------------------------------------------------

-- A placement is appended after the slice's existing ones: its index is one past
-- the highest index already in the slice, or zero when it is the first. An
-- element may be placed in a given slice at most once (see invariant
-- PlacementElementUnique), while the same element may still be placed in many
-- slices and many timelines.
rule PlaceElement {
    when: PlaceElement(slice, element, id?)
    ensures: ElementPlacement.created(
        slice: slice,
        element: element,
        index: next_index(slice.placements)
    )
}

-- Remove the placement of `element` from `slice`. A placement is addressed by
-- (slice, element), its natural key (see invariant PlacementElementUnique), so
-- no placement id is used to address one; removing a placement that is not in
-- the slice is rejected rather than a silent no-op.
rule RemovePlacement {
    when: RemovePlacement(slice, element)
    requires: slice.placements.any(p => p.element = element)
    ensures: not exists ElementPlacement{slice, element}
}

-- Connections ---------------------------------------------------------------

rule Connect {
    when: Connect(from, to, id?)
    ensures: Connection.created(model: from.model, from: from, to: to)
}

rule Disconnect {
    when: Disconnect(connection)
    ensures: not exists connection
}

-- Field derivations (the connection-local provenance contribution) are edited
-- one entry at a time, keyed by the target field they produce.

-- Upsert the derivation {target_field, source_fields} into the connection's
-- derivations, replacing any existing entry for the same target_field; the rest
-- is preserved.
rule AddDerivation {
    when: AddDerivation(connection, target_field, source_fields)
    requires: non_blank(target_field)
    requires: source_fields.count > 0
    let entry = FieldDerivation{ target_field: target_field, source_fields: source_fields }
    ensures: connection.derivations = upsert_by(connection.derivations, entry, d => d.target_field)
}

-- Remove the derivation for `target_field`; the rest is preserved.
rule RemoveDerivation {
    when: RemoveDerivation(connection, target_field)
    ensures: connection.derivations = remove_by(connection.derivations, target_field, d => d.target_field)
}

-- Specifications (Given / When / Then) --------------------------------------

rule AddSpecification {
    when: AddSpecification(slice, title, id?)
    requires: non_blank(title)
    -- Unique within this slice, not the model (see invariant
    -- SpecificationTitleUnique).
    requires: not slice.specifications.any(spec => same_name(spec.title, title))
    ensures: Specification.created(slice: slice, title: title)
}

-- Rename a specification's title, unique within its slice (see invariant
-- SpecificationTitleUnique) and referenced by nothing: a specification is
-- addressed by identity, and its title travels to another boundary only as part
-- of a breadcrumb (see NameResolution.CandidateDisambiguation).
rule RenameSpecification {
    when: RenameSpecification(spec, new_title)
    requires: non_blank(new_title)
    requires: not spec.slice.specifications.any(other =>
        other != spec and same_name(other.title, new_title))
    ensures: spec.title = new_title
}

-- Add a normal step that asserts about an existing element.
rule AddSpecStep {
    when: AddSpecStep(spec, clause, element, index, id?)
    ensures: SpecStep.created(
        spec: spec,
        clause: clause,
        element: element,
        index: index,
        is_error: false,
        expect_empty: false
    )
}

-- Add an error outcome (a then-step that refers to no element).
rule AddErrorStep {
    when: AddErrorStep(spec, error_name, index, id?)
    requires: non_blank(error_name)
    ensures: SpecStep.created(
        spec: spec,
        clause: then_step,
        error_name: error_name,
        index: index,
        is_error: true,
        expect_empty: false
    )
}

-- Rename an error outcome, leaving the step's clause, position and identity
-- alone. An error step is a then-step that refers to no element (see
-- AddErrorStep) and carries its outcome as a name, so renaming that name is the
-- step's whole state change.
-- error_name is CONTENT, not an identifier: no boundary resolves a step by name
-- (see NameResolution.ResolvableScope), a step is addressed by identity or by
-- (spec, clause, index), and the name is what the specification asserts the
-- system produces. No uniqueness is required of it, and two error steps of one
-- specification may carry the same name - AddErrorStep does not guard against
-- that either, so this rule introduces no new constraint on error_name.
-- The guard is consequently the SHAPE of the target rather than a collision: only
-- an error step is renamed this way. A normal step's element reference is set and
-- cleared through AddSpecStep and RemoveSpecStep.
rule RenameErrorStep {
    when: RenameErrorStep(step, new_error_name)
    requires: step.is_error
    requires: non_blank(new_error_name)
    ensures: step.error_name = new_error_name
}

rule RemoveSpecStep {
    when: RemoveSpecStep(step)
    ensures: not exists step
}

-- Concrete example field values for a step (test data) are edited one entry at
-- a time, keyed by the field name they populate.

-- Upsert the example {field_name, field_value} into the step's examples,
-- replacing any existing entry for the same field_name; the rest is preserved.
-- Both field_name and field_value must be non-blank.
rule AddStepExample {
    when: AddStepExample(step, field_name, field_value)
    requires: non_blank(field_name)
    requires: non_blank(field_value)
    let entry = Example{ field_name: field_name, field_value: field_value }
    ensures: step.examples = upsert_by(step.examples, entry, e => e.field_name)

    @guidance
        -- This rule is the authoring surface's entry point for example values
        -- and owns their shape validation: it rejects any AddStepExample whose
        -- field_name or field_value is blank, rather than trusting adapters to
        -- pre-validate (that guard formerly lived in CLI-adapter code). A
        -- historical bug persisted CLI objects keyed `field`/`value` verbatim
        -- without mapping them to the Example shape, so read paths (GET model,
        -- ModelChangeStream) saw empty examples. The requires guards here reject
        -- that at the source; the ExamplesWellFormed invariant catches any
        -- residual empty-string degradation reaching persisted state by any
        -- other path. A whole-list replace form of this edit still exists
        -- internally (the interchange import uses it to re-attach a document's
        -- examples), but it is not exposed on the authoring surface, so this
        -- rule is the only shape-validated entry point an operator has.
}

-- Remove the example for `field_name`; the rest is preserved.
rule RemoveStepExample {
    when: RemoveStepExample(step, field_name)
    ensures: step.examples = remove_by(step.examples, field_name, e => e.field_name)
}

rule SetStepExpectEmpty {
    when: SetStepExpectEmpty(step, value)
    ensures: step.expect_empty = value
}

-- Wireframes ----------------------------------------------------------------

-- Wireframe editing works on a screen's layout tree as a whole: every edit is
-- validated before it is applied, so an operation that would leave the tree
-- malformed, or that would leave it referring to a field the screen does not
-- have, is rejected and changes nothing. The reference is protected from the
-- field side too: an edit that would remove a field name the screen's stored
-- layout still names is rejected (see RemoveField), so no field edit can strand
-- a layout reference.
--
-- The tag vocabulary is the black box here; the full per-tag matrix is tabulated
-- in doc/wireframe-dsl.md. These helpers express it:
--   tag_schema_valid(tag, attributes): `attributes` are exactly the attributes
--     `tag` admits, every attribute `tag` requires is present, and each value
--     holds the type - and, where the tag declares one, lies within the allowed
--     set - that the tag's schema declares for it.
--   attribute_admitted(tag, attribute) and
--     attribute_value_valid(tag, attribute, value): the per-attribute halves of
--     the same check. An attribute value supplied as operator text is coerced
--     to the type the tag declares for that attribute before it is checked, the
--     same treatment whether the attribute is given when the node is created or
--     set later through SetWireframeAttr. Text that cannot be coerced, or that
--     falls outside the set the tag allows for the attribute, is rejected and
--     the edit changes nothing.
--     The String declared on WireframeAttribute.value is the form an operator
--     supplies, not the type the model holds: the value is held as the type the
--     tag's schema declares for that attribute.
--   text_tag(tag): the tag carries a text content.
--   fields_resolve(screen, attributes): every field-name value among
--     `attributes` names a field declared on `screen`, so a layout refers only
--     to the fields of the screen that owns it. Names are matched by the model's
--     name equality, the same equality the declaration and every other reference
--     use.
--   field_referenced_by_layout(screen, name): a node in `screen`'s stored layout
--     still names the field `name` through its field-name attribute; false when
--     the screen carries no layout, or no node names that field. A field a
--     stored layout names may not be removed (see RemoveField), so no field edit
--     can leave a layout referring to a field the screen no longer declares; a
--     rename, by contrast, rewrites the attribute rather than being blocked by it
--     (see RenameField). Matched by name equality, like every other field
--     reference.
--   wireframe_well_formed(node): the tree rooted at `node` is structurally
--     valid: every tag is known, every node's attributes satisfy its tag's
--     schema, leaf tags carry no children, text tags carry a text content
--     instead of child nodes (the content may still be empty: a node is added
--     first and filled by SetWireframeText), container tags carry child nodes
--     rather than text content (a container may hold none: a tree is grown one
--     node at a time, and every layout begins as a bare canvas), and the root is
--     the canvas node while no node below the root is one (`canvas` is the
--     layout's root, always its first node).
-- Tree addressing, and the edits themselves:
--   empty_wireframe: a layout consisting of just its canvas root.
--   root_node_id(tree), node_exists(tree, node_id), node_tag(tree, node_id),
--     next_node_id(tree).
--   append_node(tree, parent, node), insert_before(tree, sibling, node),
--     set_node_attribute(tree, node, attribute, value),
--     set_node_text(tree, node, text), remove_node(tree, node).

-- Append a node as the last child of `parent`, or of the root when no parent is
-- named. Only container tags take children, so this is what grows a tree; `text`
-- supplies the content of a text tag. A screen with no layout yet starts from an
-- empty wireframe.
rule AddWireframeNode {
    when: AddWireframeNode(screen, tag, attributes, parent?, text?)
    requires: screen.element_type = screen
    -- The canvas is the layout's root, created with the layout itself (a screen
    -- with no layout starts from empty_wireframe). No node below it may be one.
    requires: tag != canvas
    requires: tag_schema_valid(tag, attributes)
    requires: fields_resolve(screen, attributes)
    let tree = screen.wireframe ?? empty_wireframe
    requires: parent = null or node_exists(tree, parent)
    let node = WireframeNode{
        node_id: next_node_id(tree),
        tag: tag,
        attributes: attributes,
        text: text,
        children: []
    }
    ensures: screen.wireframe = append_node(tree, parent, node)
}

-- Insert a node immediately before an existing sibling, preserving the target
-- sibling's position and every existing node id. The root has no parent, so it
-- cannot be a target.
rule AddWireframeNodeBefore {
    when: AddWireframeNodeBefore(screen, sibling, tag, attributes, text?)
    requires: screen.element_type = screen
    requires: screen.wireframe != null
    requires: node_exists(screen.wireframe, sibling)
    requires: sibling != root_node_id(screen.wireframe)
    requires: tag != canvas
    requires: tag_schema_valid(tag, attributes)
    requires: fields_resolve(screen, attributes)
    let node = WireframeNode{
        node_id: next_node_id(screen.wireframe),
        tag: tag,
        attributes: attributes,
        text: text,
        children: []
    }
    ensures: screen.wireframe = insert_before(screen.wireframe, sibling, node)
}

-- Replace one attribute of a node, leaving that node's other attributes, its
-- children and every node id untouched. The attribute must be one the node's tag
-- admits, carrying a value of the type that tag's schema declares for it.
rule SetWireframeAttr {
    when: SetWireframeAttr(screen, node, attribute, value)
    requires: screen.wireframe != null
    requires: node_exists(screen.wireframe, node)
    requires: attribute_admitted(node_tag(screen.wireframe, node), attribute)
    requires: attribute_value_valid(node_tag(screen.wireframe, node), attribute, value)
    requires: fields_resolve(screen, [{name: attribute, value: value}])
    ensures: screen.wireframe = set_node_attribute(screen.wireframe, node, attribute, value)
}

-- Replace the text content of a text tag, leaving its attributes and children
-- alone.
rule SetWireframeText {
    when: SetWireframeText(screen, node, text)
    requires: screen.wireframe != null
    requires: node_exists(screen.wireframe, node)
    requires: text_tag(node_tag(screen.wireframe, node))
    ensures: screen.wireframe = set_node_text(screen.wireframe, node, text)
}

-- Remove a node together with its whole subtree; unaffected nodes keep their
-- ids. Removing the root removes the screen's layout entirely - the screen
-- itself is untouched and may carry a new layout later.
rule DeleteWireframeNode {
    when: DeleteWireframeNode(screen, node)
    requires: screen.wireframe != null
    requires: node_exists(screen.wireframe, node)
    ensures:
        if node = root_node_id(screen.wireframe):
            screen.wireframe = null
        else:
            screen.wireframe = remove_node(screen.wireframe, node)
}

-- Change stream subscriptions -----------------------------------------------

-- A frontend connects to a model's live change stream. Creating the
-- subscription is what triggers the initial snapshot (see ChangeStream).
rule Subscribe {
    when: Subscribe(model)
    ensures: Subscription.created(model: model)
}

-- A frontend disconnects; its subscription is removed.
rule Unsubscribe {
    when: Unsubscribe(subscription)
    ensures: not exists subscription
}

-- Deletion & rename ---------------------------------------------------------

-- Deleting a timeline cascades to its slices, and through them to their
-- placements, specifications and steps (the removals DeleteSliceCascades
-- states). The cascade is the deletion's EFFECT, applied as one operation: no
-- DeleteSlice or DeleteSpecification rule fires, so exactly one delta carries
-- every removal (see DeltaPerMutation).
rule DeleteTimelineCascades {
    when: DeleteTimeline(timeline)
    ensures:
        for s in timeline.slices:
            for p in s.placements:
                not exists p
    ensures:
        for s in timeline.slices:
            for sp in s.specifications:
                for st in sp.steps:
                    not exists st
    ensures:
        for s in timeline.slices:
            for sp in s.specifications:
                not exists sp
    ensures:
        for s in timeline.slices:
            not exists s
    ensures: not exists timeline
}

-- Deleting a slice removes its placements, its specifications and their steps.
-- The single-source Elements those placements referenced survive in the model's
-- registry. Like the timeline cascade above, this is one operation that removes
-- the whole subtree, not a DeleteSpecification call per specification.
rule DeleteSliceCascades {
    when: DeleteSlice(slice)
    ensures:
        for p in slice.placements:
            not exists p
    ensures:
        for sp in slice.specifications:
            for st in sp.steps:
                not exists st
    ensures:
        for sp in slice.specifications:
            not exists sp
    ensures: not exists slice
}

-- Deleting a specification cascades to its steps.
rule DeleteSpecificationCascades {
    when: DeleteSpecification(spec)
    ensures:
        for st in spec.steps:
            not exists st
    ensures: not exists spec
}

-- Deleting an element cascades to every placement that references it and every
-- connection it participates in (inbound or outbound).
rule DeleteElementCascades {
    when: DeleteElement(element)
    ensures:
        for p in element.placements:
            not exists p
    ensures:
        for c in element.outgoing:
            not exists c
    ensures:
        for c in element.incoming:
            not exists c
    ensures: not exists element
}

-- Renames ---------------------------------------------------------------------
--
-- The seven renames - RenameTimeline, RenameSwimlane, RenameSlice,
-- RenameSpecification, RenameElement, RenameErrorStep and RenameField - share two
-- guards: a non-blank new name, and no collision with a name the same container
-- already holds. RenameErrorStep takes the first and not the second, its
-- error_name being content rather than an identifier (see RenameErrorStep). They
-- differ only in what has to travel with the name.
--
-- All but one carry nothing. A timeline, a swimlane, a slice, a specification, an
-- element and an error step are addressed by identity, and the model holds no
-- textual reference to any of their names: where one of those names appears
-- elsewhere it is derived rather than stored (an element's name inside a
-- placement's rendering, a slice's title inside a resolution breadcrumb), so
-- those boundaries see the new name the moment it is written. Renaming an element
-- is the case the model already stated outright: because elements are
-- single-source and referenced by identity, all placements, connections and spec
-- steps reflect the new name automatically.
--
-- A field's name is the exception, for the same reason: a field is the model's
-- only thing referenced BY NAME rather than by identity. Its reference sites - a
-- derivation's target_field and source_fields, a field-origin override's field, a
-- step example's field_name and a layout node's field-name attribute - are
-- enumerated under RenameField, which rewrites them all in one operation. Those
-- are the complete set: a field name is vocabulary internal to this model, and no
-- boundary outside it holds one.
--
-- RenameField is therefore both the only rename with a cascade and the only one
-- that must REJECT a collision rather than update in place; see the note under
-- invariant FieldNameUnique for why that contrasts deliberately with AddField.

-- ---------------------------------------------------------------------------
-- Invariants
-- ---------------------------------------------------------------------------

-- Authoring invariant (always holds, even mid-edit): a slice may never contain
-- an element type that is a category error for it, and never more than one of
-- each singleton type. Singletons MAY be absent during incremental authoring;
-- their presence is required only at export (see Slice.is_complete).
invariant PlacementMatchesSliceType {
    for s in Slices:
        s.status != informational implies (
            (s.slice_type = state_change implies
                (s.commands.count <= 1
                 and s.read_models.count = 0 and s.automations.count = 0)) and
            (s.slice_type = state_view implies
                (s.read_models.count <= 1
                 and s.commands.count = 0 and s.automations.count = 0)) and
            (s.slice_type = automation implies
                (s.commands.count <= 1 and s.automations.count <= 1
                 and s.read_models.count = 0)))
}

-- A slice may never hold two placements of the same element, informational
-- slices included: the same element placed twice in one slice is an
-- inconsistent state. The constraint is slice-scoped only, so the same element
-- may still be placed in many slices and many timelines. This makes
-- (slice, element) the placement's natural key: ReorderPlacement and
-- RemovePlacement address a placement by it rather than by the surrogate
-- placement id, which is why no placement id is used to address one.
invariant PlacementElementUnique {
    for s in Slices:
        for p in s.placements:
            for q in s.placements:
                p != q implies p.element != q.element
}

-- An element's name is unique within its model, compared case-insensitively and
-- ignoring surrounding whitespace, so a name identifies exactly one element.
-- Two elements can therefore never tie in NameResolution's exact tier either:
-- the names it matches (case-insensitive equality) are the same name here, and
-- only one element may hold a name. Elements are
-- single-source and referenced by name wherever an operator or an agent names
-- one, so a name identifying two elements would be ambiguous exactly where the
-- model can least afford it.
-- Creation and rename reject a collision before it is written (see CreateElement,
-- RenameElement) rather than relying on this invariant alone; the invariant
-- additionally refuses one arriving by any other path, import included. Nothing
-- repairs a collision already present in a model: choosing which of two
-- same-named elements to rename, and to what, would be guessing the author's
-- intent, so such a collision is reported for a human to resolve by renaming one
-- of the two.
-- Uniqueness is per model, not global: two models may each hold an element named
-- "Order", exactly as identity is unique per model.
invariant ElementNameUnique {
    for e in Elements:
        for f in Elements:
            (e != f and e.model = f.model) implies not same_name(e.name, f.name)
}

-- The names below are constrained for the same reason as an element's, each
-- scoped to the smallest container in which it has to identify one entity.

-- A timeline's title is unique within its model. It is a group key of the
-- interchange format as much as a way to address a timeline: a slice exports its
-- timeline as the bare `context` string, and import groups slices back into
-- timelines by that string, so two same-titled timelines would collapse into one
-- and ModelRoundtrip's exact-reproduction claim would not hold for a model whose
-- only irregularity is a repeated title.
invariant TimelineTitleUnique {
    for t in Timelines:
        for u in Timelines:
            (t != u and t.model = u.model) implies not same_name(t.title, u.title)
}

-- A swimlane's name is unique within its model, and is likewise a group key: it
-- exports as the bare `element.aggregate` string and import looks a swimlane up
-- by that name, so two same-named swimlanes would collapse into one on import.
invariant SwimlaneNameUnique {
    for lane in Swimlanes:
        for other in Swimlanes:
            (lane != other and lane.model = other.model) implies
                not same_name(lane.name, other.name)
}

-- A slice's title is unique within its timeline, which is exactly the container a
-- slice candidate's breadcrumb names: a repeat inside one timeline is the one
-- case NameResolution could not tell apart. The same title in another timeline is
-- a different slice, and remains legal.
invariant SliceTitleUnique {
    for s in Slices:
        for other in s.timeline.slices:
            s != other implies not same_name(s.title, other.title)
}

-- A specification's title is unique within its slice, for the same reason: a
-- specification candidate's breadcrumb is its slice's title and that slice's
-- timeline's title, so a repeat inside one slice is the case resolution could not
-- tell apart. The same title in another slice remains legal.
invariant SpecificationTitleUnique {
    for spec in Specifications:
        for other in spec.slice.specifications:
            spec != other implies not same_name(spec.title, other.title)
}

-- A field's name is a name like any other, compared the same way and constrained
-- for the same reason, scoped to the smallest container that has to tell one
-- field from another: its field list. No field list - an element's, or any
-- field's subfields, however deep - holds two fields under one name.
-- The reason bites harder for a field than for an entity, because a field name is
-- the model's one textual reference rather than an identity anything points at: a
-- derivation, a field-origin override, a step example and a layout node each NAME
-- a field, so a name holding two candidates would make every one of those
-- references ambiguous - a derivation sourcing the wrong field, a layout
-- presenting one the author did not mean. Where an element's name collides the
-- model cannot address the element; where a field's name collides the model cannot
-- tell what a reference already written means.
-- Rejection happens before a collision is written (RenameField rejects one, and
-- AddField never creates one because it upserts by name), and - as with an
-- element's name - the invariant additionally refuses one arriving by any other
-- path, import included: a document whose one element declares two fields under
-- one name is rejected rather than installed. Nothing repairs a collision already
-- present, since choosing which of two same-named fields to rename, and to what,
-- would be guessing the author's intent.
-- The asymmetry with AddField is deliberate and not an oversight. AddField is
-- keyed on the name because it is how a field's type, optionality and cardinality
-- are edited, so it must be able to match an existing field by name, and a name it
-- finds is UPDATED in place. RenameField MOVES an existing field onto a name, so a
-- collision there would silently destroy the field already holding it, and is
-- REJECTED instead. The two also differ in what they imply for references:
-- updating a field in place leaves every reference spelling as it was, while a
-- rename respells them all (see RenameField).
invariant FieldNameUnique {
    for e in Elements:
        field_names_unique(e.fields)
}

-- A specification's Given/When/Then steps must match its slice's pattern.
-- state_change and automation share one shape; state_view has its own.
-- Always-on (loosened for incremental authoring): given steps are events; When
-- steps are commands only; for state_change/automation, Then holds events
-- (multiple) and/or an error; for state_view, Then is the read_model only (no
-- events, no error steps) and there is no When. The "exactly one
-- command/read_model" requirement is deferred to export (Specification.is_complete).
invariant SpecificationComposition {
    for spec in Specifications:
        spec.given_steps.all(s => s.element?.element_type = event) and
        spec.when_steps.all(s => s.element?.element_type = command) and
        ((spec.slice.slice_type = state_change or spec.slice.slice_type = automation) implies (
            spec.when_commands.count <= 1 and
            spec.then_steps.all(s => s.is_error or s.element?.element_type = event))) and
        (spec.slice.slice_type = state_view implies (
            spec.when_steps.count = 0 and
            spec.then_read_models.count <= 1 and
            spec.then_steps.all(s => s.element?.element_type = read_model)))
}

-- Every recorded example on a spec step must carry both a non-empty
-- field_name and a non-empty field_value. The Example value type already
-- forces both fields to be present non-optional Strings; this invariant
-- additionally forbids the empty-string degradation a lax authoring
-- adapter can produce when it forwards a JSON payload with unexpected
-- keys and lets missing/absent values default to empty on read.
invariant ExamplesWellFormed {
    for step in SpecSteps:
        step.examples.all(e => non_blank(e.field_name) and non_blank(e.field_value))
}

-- Connections may only follow the Event Modeling patterns.
invariant ValidConnectionElementTypes {
    for c in Connections:
        (c.from.element_type = screen and c.to.element_type = command) or
        (c.from.element_type = command and c.to.element_type = event) or
        (c.from.element_type = event and c.to.element_type = read_model) or
        (c.from.element_type = read_model and c.to.element_type = screen) or
        (c.from.element_type = read_model and c.to.element_type = automation) or
        (c.from.element_type = automation and c.to.element_type = command)
}

-- A layout tree is always structurally well-formed: known tags only, each node's
-- attributes exactly as its tag's schema admits, no children on leaf tags, a
-- text content (and no child nodes) on text tags, child nodes (and no text
-- content) on container tags, and a canvas root. Every wireframe edit validates
-- the resulting tree before it is applied, so this holds at every observable
-- state.
invariant WireframeWellFormed {
    for e in Elements:
        e.wireframe != null implies (
            e.element_type = screen and wireframe_well_formed(e.wireframe))
}

-- A layout refers only to fields its own screen declares: every field-name value
-- in a screen's stored layout names a field the screen has. Three edits keep this
-- true. Every wireframe edit that would name an unresolvable field is rejected
-- before it is applied (see AddWireframeNode, AddWireframeNodeBefore and
-- SetWireframeAttr); the field side is guarded too, so an edit that would remove a
-- name the screen's stored layout still refers to is rejected (see RemoveField);
-- and renaming a field rewrites the layout attribute that names it along with the
-- declaration (see RenameField), which is what lets a rename carry the reference
-- with it rather than being blocked by it. Reference resolution therefore holds at
-- every observable state, not merely at the moment a layout first names the field,
-- and the names it resolves are compared by the model's name equality (same_name).
-- field_references(tree) is every field-name value the tree names.
invariant WireframeReferencesResolve {
    for e in Elements:
        e.wireframe != null implies (
            e.element_type = screen and
            field_references(e.wireframe).all(ref =>
                e.fields.any(f => same_name(f.name, ref.field_name))))
}

-- ---------------------------------------------------------------------------
-- Interchange format contract
-- ---------------------------------------------------------------------------

contract SchemaCodec {
    import: (document: Any) -> EventModel
    export: (model: EventModel) -> Any

    @invariant ExportRequiresComplete
        -- export is defined only for an export-ready model: every Slice whose
        -- status is not 'informational' must satisfy Slice.is_complete, and every
        -- Specification of such a slice must satisfy Specification.is_complete.
        -- Incomplete models are rejected with the offending slices/specs
        -- reported, never silently exported. Slices tagged informational carry no
        -- actionable content and are dropped on export, so neither they nor the
        -- specifications inside them can block it: content that will not be
        -- written is not required to be complete.

    @invariant ModelRoundtrip
        -- For any export-ready model the CLI can author, import(export(model))
        -- reproduces the schema-representable canonical subset exactly. The
        -- canonical model is the source of truth, so everything the interchange
        -- format can carry round-trips without loss. The format's two grouping
        -- keys - slice.context, which names a Timeline, and element.aggregate,
        -- which names a Swimlane - each identify exactly one timeline/swimlane,
        -- because those names are unique within a model (see the uniqueness
        -- invariants), so neither key can merge two of them into one on reimport.
        -- Both keys are names, so both are compared by the model's name equality
        -- (the same_name convention): a document whose slices name two contexts
        -- that differ only in case describes one timeline, and its slices are
        -- grouped into that one, rather than the document being rejected because
        -- the model cannot hold both spellings.
        -- Fields the
        -- eventmodeling.schema.json format has no place for - Connection.derivations,
        -- Element.field_origins, Element.wireframe and Swimlane.index (see the
        -- dropped-fields guidance) - are excluded from this guarantee; they are
        -- dropped on export like the other unrepresentable fields. So are the
        -- references the projection cannot carry in full: an element that no slice
        -- places is exported as no element, so a dependency or a step naming one
        -- (and the connection or step itself) is not reconstructed on import (see
        -- the dropped-fields guidance and the placement-bound limit stated under
        -- GroupIdIsElementIdentity).

    @invariant SchemaRoundtrip
        -- Round-tripping a foreign document is semantic, not byte-lossless. For
        -- a document valid against eventmodeling.schema.json and accepted by
        -- import (see ImportRejectsForbiddenDocument),
        -- export(import(document)) preserves the canonical subset of the
        -- document - the fields this model represents - normalising ids and
        -- ordering and dropping visual layout. Fields outside the canonical
        -- model (see the dropped-fields guidance below) are NOT preserved. A
        -- document the always-on invariants reject has no import result, so this
        -- guarantee is vacuous for it (see GroupIdIsElementIdentity for the
        -- concrete case: the same groupId embedded twice inside one slice).

    @invariant GroupIdIsElementIdentity
        -- A canonical Element's identity is its schema groupId. Each placement
        -- exports as a distinct embedded schema Element with a unique id but the
        -- element's shared groupId. On import, embedded elements sharing a
        -- groupId collapse into one Element; an element with no groupId becomes
        -- its own Element. The schema embeds elements only inside slices, so
        -- only PLACED elements participate in the round-trip: an element with no
        -- placement has no embedded representation and is not exported (the
        -- round-trip is placement-bound).
        -- Placed copies therefore appear as one embedded element per placement, and
        -- within a single slice at most one embedded element may carry a given groupId;
        -- a document embedding the same groupId twice inside one slice is unrepresentable
        -- and is rejected on import as a whole (see ImportRejectsForbiddenDocument).

    @invariant DependenciesPerPlacement
        -- Each Connection exports as an OUTBOUND dependency on every embedded
        -- copy of its 'from' element and an INBOUND dependency on every embedded
        -- copy of its 'to' element. On import, dependencies are deduplicated by
        -- (from groupId, to groupId) back into a single Connection.

    @invariant ImportRejectsForbiddenDocument
        -- import applies the same authoring operations an operator uses, so the
        -- always-on authoring invariants hold over an imported document too. A
        -- document those invariants reject is rejected as a whole, naming what
        -- the failing operation concerned - the slices for a slice-level step, the
        -- elements or swimlanes for an element-level one - and nothing is
        -- installed: import is all-or-nothing, and the running model is left
        -- unchanged.

    @guidance
        -- Tolerant enums: a document whose status, sliceType or field type falls
        -- outside the value set this model knows is imported with that value
        -- normalised to the default the codec documents (an unknown status to
        -- created, an unknown sliceType to state_change, an unknown field type to
        -- custom) rather than rejected. The interchange format's enums are
        -- broader than this model's, and rejecting a whole document over one
        -- unrecognised value would refuse documents whose canonical subset is
        -- perfectly representable.
        --
        -- Dropped fields (deliberate, documented loss in favour of a clean
        -- model): they have no canonical representation, are emitted empty/
        -- absent on export and discarded on import.
        --   * technical element fields: apiEndpoint, service, sketched,
        --     prototype, listElement, createsAggregate, aggregateDependencies
        --   * tags (no element categorisation in this model)
        --   * element.domain (no subdomain concept; emitted empty)
        --   * element.triggers and Slice.actors (no Actor concept; triggers are
        --     captured as screen/automation -> command connections)
        --   * slices tagged informational (no schema sliceType for them)
        --   * Connection.derivations and Element.field_origins: information-
        --     completeness provenance is authoring-only metadata with no
        --     eventmodeling.schema.json representation (the format carries no
        --     field-level derivation or field-origin concept), so it is dropped
        --     on export and not reconstructed on import. A model that relies on
        --     derivations/overrides to be information-complete will read as
        --     incomplete after a schema round-trip; this is the documented loss.
        --   * a reference to an element the document does not embed: the format
        --     carries a dependency's or a specification step's target as a
        --     title/type pair (plus, for a dependency, its groupId), while the
        --     canonical element lives in the model's registry whether or not any
        --     slice places it. An element placed nowhere is therefore exported as
        --     no element at all (see GroupIdIsElementIdentity), and a step or a
        --     dependency naming one is dropped on import rather than reinstating
        --     an element whose fields, context and swimlane the document cannot
        --     state. The step or connection it belonged to goes with it; see the
        --     open question on reinstating the referenced element.
        --   * a specification step whose type is absent or outside the format's
        --     step types (SPEC_EVENT, SPEC_COMMAND, SPEC_READMODEL, SPEC_ERROR):
        --     a step asserts about an element of a type, and an unrecognised type
        --     names no element type the model could map it to, so the step is dropped
        --     rather than guessed at. Unlike the enum values above, this is not a
        --     tolerated value with a default: there is no sensible default step.
        --   * a screenImages entry whose elementId names no element the slice
        --     embeds: the image url has no element to attach to, so it is dropped
        --     with it. An image on an element the document does embed is applied
        --     (screenImages.url <-> Element.image_url, below).
        --   * Swimlane.index: author-controlled render order. The schema has no
        --     aggregate ordering (aggregates are bare names on elements), so the
        --     order is dropped on export; swimlane NAMES still round-trip via
        --     element.aggregate. Reimported swimlanes fall back to creation order.
        --   * Element.wireframe: a screen's layout tree is authoring-only in the
        --     same way. The format describes an element's name, type, context,
        --     fields and aggregate, but carries no layout of any kind, so a
        --     wireframe is dropped on export and not reconstructed on import. A
        --     screen's fields still round-trip; only the layout that presents
        --     them is lost.
        -- Preserved mappings: slice.context <-> Timeline.title;
        --   element.aggregate <-> Swimlane.name (the two grouping keys, unique per
        --   model, so each names exactly one timeline/swimlane on reimport);
        --   sliceType <-> Slice.slice_type;
        --   element.type <-> Element.element_type;
        --   element.context <-> Element.context;
        --   screenImages.url <-> Element.image_url; dependencies <-> Connection;
        --   slice index/status <-> Slice.index/status.
}

-- @note SchemaCodec import/export is implemented in emcli.schema: export
-- rejects models that are not export-ready and drops the fields with no schema
-- representation - informational slices, the technical/visual fields, the
-- information-completeness provenance (Connection.derivations,
-- Element.field_origins) and screen layouts (Element.wireframe) - emitting one
-- embedded element per placement sharing the element's groupId; import collapses
-- elements by groupId and deduplicates dependencies back into connections.
-- ModelRoundtrip (over the schema-representable subset) and the
-- groupId/dependency identity invariants are covered by emcli.schema-test.
--
-- @note Import applies a document through the same operations an operator uses,
-- so the always-on authoring invariants hold while importing too: a document
-- those invariants admit imports cleanly, while a document they reject is
-- rejected as a whole - naming what the failing operation concerned - and nothing
-- is installed (ImportRejectsForbiddenDocument).

-- The live change stream a frontend consumes to visualise a model as it is
-- edited. Outbound only: the frontend receives changes, never issues edits over
-- this boundary (authoring happens through ModelAuthoring).
contract ChangeStream {
    -- A full snapshot of the canonical model, sent once when a client connects.
    -- Complete on its own for the state it captures: it carries the model's whole
    -- element registry, so every element id a later delta refers to resolves for a
    -- consumer that holds this snapshot plus the deltas delivered after it -- the
    -- elements that existed when it was taken come from the snapshot, and an
    -- element created later comes from the delta that created it.
    snapshot: (model: EventModel) -> Any
    -- A single incremental change, sent for each subsequent mutation.
    delta: (change: Any) -> Any

    @invariant SnapshotThenDeltas
        -- On subscribe, the first message a client receives is exactly one
        -- snapshot of the current canonical model. Every message thereafter is
        -- a delta. The snapshot-then-delta sequence has no gap: no mutation
        -- committed after the snapshot is taken is lost or duplicated. The one
        -- exception is replacing the model wholesale: an import installs a whole
        -- document, which no per-entity delta could express without enumerating
        -- a removal for every entity the model held, so every subscriber receives
        -- a fresh snapshot instead and the sequence starts again from it.

    @invariant DeltaPerMutation
        -- Every authoring operation that mutates the model (every mutating
        -- operation of the ModelAuthoring surface) produces exactly one delta,
        -- delivered in commit order to every active Subscription on that model.
        -- A delta carries every entity whose observable state changed, not only
        -- the entity the operation was aimed at: because an element's
        -- completeness follows from the connections pointing at it, wiring or
        -- unwiring an element re-states that element as well as creating or
        -- removing the connection. Each affected entity appears once, carrying
        -- its full new state.
        -- A composite operation - one the surface offers as a single verb but
        -- which edits one entry of a whole-list field (AddField, RemoveField,
        -- AddFieldOrigin, RemoveFieldOrigin, AddDerivation, RemoveDerivation,
        -- AddStepExample, RemoveStepExample) - reports the delta of the
        -- operation it decomposes into and is named for it: SetFields,
        -- SetFieldOrigins, SetConnectionDerivations or SetStepExamples, as the
        -- change-stream schema lists. Exactly one delta per mutation holds either
        -- way.
        --
        -- RenameField is the one composite that decomposes into no single
        -- whole-list edit: it respells a name across the element's fields, its
        -- field_origins, its layout, the derivations of every connection that
        -- touches it and the examples of every step that asserts about it. It is
        -- a named operation in its own right, and its ONE delta carries every
        -- entity whose observable state changed: the element (fields,
        -- field_origins and wireframe together, appearing once), each connection
        -- whose derivations named the field, each step whose examples did, and any
        -- element at the far end of an outgoing connection whose completeness
        -- followed the source field's respelling - the same reason Connect
        -- restates its target. An entity the respelling did not reach is NOT in
        -- the changes, so renaming a field nothing references emits the element
        -- alone. The other renames - RenameSlice, RenameSpecification,
        -- RenameErrorStep, alongside the longer-standing RenameTimeline,
        -- RenameSwimlane and RenameElement - are single-entity deltas.
        -- An operation that succeeds without changing anything - reordering an
        -- element to where it already sits - still emits its delta, carrying no
        -- changed entities: the stream records the operations the model accepted,
        -- so a client sees the operation rather than silence.

    @invariant CanonicalShape
        -- Snapshots and deltas carry the canonical model shape - timelines,
        -- swimlanes, single-source elements, connections, slices and specs -
        -- NOT the eventmodeling.schema.json projection. The stream is for
        -- visualisation, so timelines and swimlanes (absent from the schema)
        -- are present. Because entities are referenced by id, a snapshot must
        -- also be enough to resolve every reference it makes and every
        -- reference a later delta makes to an entity it created: it therefore
        -- carries the model's whole element registry, each element in the same
        -- canonical record shape a delta carries, rather than only the elements
        -- its placement and connection entries reach. (The schema projection,
        -- by contrast, embeds elements only inside slices, so it stays
        -- placement-bound - see SchemaCodec.GroupIdIsElementIdentity.)
        -- One value travels in an encoding of its own rather than in the
        -- declaration above: a screen's layout tree is a nested sequence of tag,
        -- id map, attribute map and children, pinned by the change-stream schema
        -- and doc/wireframe-dsl.md, because that is the shape the wireframe
        -- operations edit node by node. WireframeNode declares that tree in the
        -- model; the wire carries the tree, not a second form of it.
}

-- ---------------------------------------------------------------------------
-- Name resolution query (server-side name -> candidate resolution)
-- ---------------------------------------------------------------------------

-- The human-nameable entity kinds a caller can resolve a name against. These
-- are exactly the entities the ModelAuthoring mutating operations take by
-- reference: Timeline (title), Swimlane (name), Slice (title), Element (name)
-- and Specification (title). ElementPlacement, Connection and SpecStep are not
-- nameable and are out of scope.
enum ResolvableKind { timeline | swimlane | slice | element | specification }

-- One name to resolve within a batch. The optional kind_hint records which kind
-- the caller believes the name denotes; it only influences candidate ranking,
-- never inclusion (see NameResolution.HintRanksNeverFilters).
value NameQuery {
    name: String
    kind_hint: ResolvableKind?
}

-- A read-only, non-mutating query that resolves the (few) human-readable names
-- mentioned in a single turn to concrete model entities, so an LLM driving the
-- CLI can turn names into the entity references the mutating ModelAuthoring
-- operations require - without ever dumping the whole model, or a full id/name
-- index, into its context window. Fulfilled by the ModelAuthoring surface,
-- alongside SchemaCodec import/export.
contract NameResolution {
    -- Resolve a batch of names against one model in a single round trip,
    -- returning the candidate set for each queried name. The result shape is
    -- opaque here (as with the SchemaCodec and ChangeStream payloads); its
    -- semantics are pinned by the invariants below.
    resolve: (model: EventModel, queries: List<NameQuery>) -> Any

    @invariant ResolvableScope
        -- Names are matched only against the human-nameable fields of the
        -- resolvable kinds: Timeline.title, Swimlane.name, Slice.title,
        -- Element.name and Specification.title. ElementPlacement, Connection and
        -- SpecStep carry no name and are never returned as candidates.

    @invariant MatchTiersWithFallback
        -- For each queried name, matching proceeds in tiers against the relevant
        -- name/title field:
        --   exact     - the model's name equality (same_name: equal apart from
        --               case and surrounding whitespace), so the names it matches
        --               are exactly the ones ElementNameUnique makes unique;
        --   substring - case-insensitive containment, used only as a fallback;
        --   near_miss - the config.resolve_candidate_cap nearest candidates by
        --               edit distance ("did you mean"), produced if and ONLY if
        --               neither exact nor substring matched anything for that
        --               name.
        -- Near-miss candidates never dilute a result that already has exact or
        -- substring matches. Every returned candidate is tagged with the tier
        -- that produced it, so the caller can tell a typo of an existing entity
        -- apart from a genuinely new name.

    @invariant HintRanksNeverFilters
        -- A query's kind_hint only influences the ordering/ranking of candidates
        -- for that name. It is never a hard filter: a real exact or substring
        -- match is never silently excluded because it is of a different kind than
        -- the one hinted.

    @invariant NoImplicitBestPick
        -- resolve reports candidates and never collapses them into a synthetic
        -- "best guess" field, even when exactly one candidate matches.
        -- Disambiguation among multiple candidates is left to the caller (the
        -- LLM or the user), never decided by this operation. A name's candidate
        -- list is capped at config.resolve_candidate_cap, so a very common name
        -- yields a prefix of its matches rather than all of them; the result
        -- states whether anything was left out, so a truncated list can never be
        -- mistaken for an exhaustive one.

    @invariant CandidateDisambiguation
        -- Each candidate carries the breadcrumb/location context that places it:
        -- a Slice candidate carries its Timeline's title; an Element candidate
        -- carries its assigned Swimlane's name when it has one; a Specification
        -- candidate carries its Slice's title and that Slice's Timeline's title.
        -- That breadcrumb is context: one name may be held by candidates of
        -- several kinds at once, and by several of ONE kind - a slice's title is
        -- unique within its timeline, not within the model, so two slices of
        -- different timelines may be titled alike (see the uniqueness
        -- invariants). What cannot arise is two candidates whose breadcrumbs also
        -- agree, because the container that makes a name unique is part of the
        -- breadcrumb itself: the candidates for one name never tie. A caller
        -- therefore never has to choose between two indistinguishable candidates.
        -- When a caller must land on ONE of them - a query's name root, see
        -- ModelQuery.RootsAreEntityKinds - the candidates are named back and the
        -- choice of id is the caller's.

    @invariant BoundedByQueryCount
        -- THE core architectural property: the size of a resolve response scales
        -- with the number of names queried (times the per-name candidate cap,
        -- config.resolve_candidate_cap), NOT with the total size of the model.
        -- Matching itself walks the model, but what comes back is bounded by the
        -- question asked, so resolving a handful of names costs the same against
        -- a model of thousands of elements as against a small one. This is what
        -- keeps name resolution cheap on a local LLM's context, versus dumping
        -- the model or a full id/name index.

    @guidance
        -- Free-text / semantic resolution ("the event that fires when checkout
        -- completes") is out of scope; that inference is the caller's job. Stale
        -- ids across a long conversation are handled elsewhere (mutation
        -- responses carry full entity state; deleting a referenced entity yields
        -- a helpful error), not by this operation.
}

-- ---------------------------------------------------------------------------
-- Structural query (read-only exploration of the model)
-- ---------------------------------------------------------------------------

-- The entity kinds a query can root on or step to. The model is deliberately
-- absent: it is the implicit context a query runs against (exactly one exists),
-- never a root and never a row. ElementPlacement and Connection are also
-- absent: they are associations (edges between entities), reachable only
-- through a relation and never rootable. See ModelQuery.
enum QueryKind { timeline | swimlane | slice | element | specification | step }

-- The two directional element -> element relations. Both endpoints are the same
-- kind, so the direction cannot be inferred and must be named; every other
-- relation is kind-directed.
enum QueryDirection { outgoing | incoming }

-- How a filter compares a field against a value: equality, inequality, regular
-- expression match, or set membership against a parenthesised list.
enum QueryComparator { equals | not_equals | matches | in_set }

-- The single operation a pipeline entry performs. `kind` records which; the
-- operands of that operation are the remaining value fields.
enum QueryStageKind { follow | where | order | select | count | limit | distinct }

-- Where a query starts: a whole kind ("all slices in the model"), or a single
-- entity named by identity or by name. A named root is resolved through
-- NameResolution, never re-matched here.
value QueryRoot {
    kind: QueryKind
    id: Integer?      -- when present, the single entity with this identity
    name: String?     -- when present, the single entity with this name (via NameResolution)
}

-- One stage of a query pipeline. `kind` selects the stage; the remaining fields
-- are that stage's operands and are absent for the other stages.
value QueryStage {
    kind: QueryStageKind

    -- follow: the kind to step to. When both the current and the target kind are
    -- Element, `direction` names which way along the connection to travel
    -- (outgoing = forward from this element, incoming = back to it); every other
    -- follow is kind-directed and leaves it absent.
    target: QueryKind?
    direction: QueryDirection?

    -- follow: an explicit edge projection `{...}` - the association fields to
    -- attach to each row under the edge's kind key. An empty list (written `{}`
    -- or `{*}`) attaches the whole association. Only valid on a follow whose
    -- relation traverses an association.
    projection: List<String>?

    -- filter: compare `field` on the current kind against `operand` using
    -- `comparator`. order: sort by `field`, descending when `descending`. Either
    -- way `field` names one of the closed set ProjectableFieldsAreClosed states;
    -- a name outside it is rejected, never silently ignored (see
    -- UnknownFieldRejected).
    field: String?
    comparator: QueryComparator?
    operand: String?
    descending: Boolean?

    -- select: the fields to project onto each row, drawn from the same closed
    -- set (see ModelQuery.ProjectableFieldsAreClosed). An absent list selects
    -- the default identity + breadcrumb shape (see
    -- ModelQuery.ResultsAreBoundedByQuestion).
    fields: List<String>?

    -- limit: the maximum number of rows to return.
    limit: Integer?
}

-- A complete structural query: a root and an ordered pipeline of stages,
-- applied left to right.
value QueryExpression {
    root: QueryRoot
    stages: List<QueryStage>
}

-- A read-only, non-mutating structural query over one model: follow relations
-- outward from a root and return the bounded set of entities the question
-- reaches, optionally carrying the association that was traversed. This is the
-- relational counterpart to NameResolution - where resolve turns names into
-- identities, this explores structure without dumping the model. Fulfilled by
-- the ModelAuthoring surface, alongside NameResolution and SchemaCodec.
contract ModelQuery {
    -- Evaluate `expression` against one model and return the matching rows. The
    -- result shape is opaque here (as with the SchemaCodec, ChangeStream and
    -- NameResolution payloads); its semantics are pinned by the invariants below.
    query: (model: EventModel, expression: QueryExpression) -> Any

    @invariant ModelIsImplicitContext
        -- The model is the query's context, not a node in the graph. Exactly one
        -- model exists per spec instance; any multi-model representation
        -- elsewhere is incidental and never surfaces here. A query can neither
        -- root on, step to, nor return the model.

    @invariant RootsAreEntityKinds
        -- A query roots on one of the six entity kinds - meaning every entity of
        -- that kind in the model - or on a single entity by identity (id) or by
        -- name. Name-based roots are resolved through NameResolution; this
        -- contract performs no name matching of its own.
        -- A root names ONE entity, so a name root takes only a candidate that
        -- matches both the kind the root declares and NameResolution's exact
        -- tier. The substring and near-miss tiers exist to help a caller choose
        -- among candidates; taking one as a root would be the implicit best pick
        -- NameResolution.NoImplicitBestPick forbids, and would answer a different
        -- question than the one asked - `element:Order flow` must not land on a
        -- timeline. A root whose name matches nothing of the declared kind is
        -- rejected (see UnknownStepRejected), naming the nearest candidates of
        -- that kind so the caller can correct the root; an empty result would read
        -- as 'nothing is related to X' when the truth is 'there is no X'.
        -- A name root exists for the kinds that carry a name - the ResolvableKind
        -- set: Timeline, Swimlane, Slice, Element and Specification. A SpecStep
        -- carries no name (see NameResolution.ResolvableScope), so a step root is
        -- by kind or by id alone: `step:42`, never `step:Some title`.

    @invariant AssociationsAreNeverRoots
        -- ElementPlacement and Connection are associations (edges between
        -- entities), not entities in their own right, and are never named as
        -- roots. They are reached only by traversing the relation between the
        -- entities they join, and never appear as bare rows.

    @invariant RelationVocabulary
        -- The relations a follow stage may name, and the kind each lands on (a
        -- relation is named by its target kind; singular and plural spellings of
        -- a kind are equivalent, e.g. slice = slices):
        --   timeline      -> slice
        --   slice         -> timeline
        --   slice         -> element            (via placement)
        --   element       -> slice              (via placement)
        --   slice         -> specification
        --   specification -> slice
        --   specification -> step
        --   step          -> specification
        --   step          -> element            (absent for an error step)
        --   element       -> step
        --   element       -> swimlane           (absent if the element is unassigned)
        --   swimlane      -> element
        --   element       -> element            (via connection; direction = outgoing | incoming)
        -- Every containment foreign key is traversable in both directions (each
        -- forward row above has its reverse), so the rule is "reverse foreign
        -- keys are traversable" rather than a hand-picked list. Only
        -- model-scoped foreign keys are excluded, because the model is the
        -- implicit context (ModelIsImplicitContext). element -> element is the
        -- sole relation whose two endpoints are the same kind, so it alone
        -- requires a direction; all others are unambiguous.

    @invariant EdgeAttributesAreProjected
        -- An association's own attributes (placement.index, connection.derivations)
        -- are reachable only by explicitly projecting the edge on the relation
        -- that traverses it. Projection attaches the association to each row
        -- under its kind key (placement or connection); the association is never
        -- returned as a bare row, and without projection a row carries only the
        -- landed entity. A projection naming an attribute the association does
        -- not carry is rejected, naming what it does carry - the same treatment
        -- UnknownFieldRejected gives a stage, and for the same reason: an
        -- unvalidated name would attach nothing and read as an empty edge.

    @invariant ProjectableFieldsAreClosed
        -- The field names a select, where or order stage may name are closed, and
        -- the closure is this specification's entity declarations rather than an
        -- open record: a stage may name the row's own display fields, or an
        -- attribute the landed entity's declaration states. Anything else is
        -- rejected (see UnknownFieldRejected).
        -- A row's display fields are its identity and its location: id; kind, the
        -- entity CATEGORY (see QueryKind); name or title; and breadcrumb - plus the
        -- projected edge under its kind key when one was requested (see
        -- EdgeAttributesAreProjected above).
        -- The entity's declared attributes give a stage its working vocabulary: an
        -- element row can name `fields` (the recursive Field list, subfields
        -- included), `element_type`, `context`, `swimlane` and
        -- `is_information_complete`; a slice row `slice_type`, `status` and
        -- `index`; a step row `clause`, `is_error` and `error_name`; and so on.
        -- `fields` is what makes an element's field names readable at all: it is
        -- the vocabulary the element operations address a field by, so a caller can
        -- learn which field names exist before adding, removing or renaming one, or
        -- before recording a derivation that names them - one round trip for the
        -- whole model, without dumping it.
        -- The set is per kind, because an entity's declaration is: a name that
        -- exists on one entity and not on another is rejected on the other, the way
        -- a relation unreachable from the current kind is (see UnknownStepRejected),
        -- naming what that row does carry.
        -- `kind` and the entity's own type are deliberately different words, and
        -- this is where the difference bites: `kind` is the entity category on this
        -- boundary (element, slice, step, ...), while what an ELEMENT is - command,
        -- event, read_model, screen, automation - is its `element_type`, and what a
        -- SLICE is is its `slice_type`. A query filtering on
        -- `element_type = command` therefore asks a different question from one
        -- filtering on `kind = element`, and both are well defined.
        -- A projection may name an attribute whose value is itself a structure - a
        -- field list, a layout tree, a reverse reference. Returning it whole is the
        -- caller's explicit request: the DEFAULT row stays lean (see
        -- ResultsAreBoundedByQuestion), and what a projection costs is what the
        -- caller asked for.

    @invariant UnknownFieldRejected
        -- A select, where or order stage naming a field outside
        -- ProjectableFieldsAreClosed's set is rejected, naming the fields that row
        -- does carry, rather than yielding an empty result. This is the field
        -- counterpart of UnknownStepRejected and takes the same posture: a
        -- misspelled or unsupported name is a mistake to correct, not an answer.
        -- An edge projection naming an attribute the association does not carry is
        -- rejected the same way (see EdgeAttributesAreProjected).
        -- Without it a query naming a field its row cannot answer is
        -- indistinguishable from a row whose value is genuinely empty - `select
        -- fields` returning nothing because a typo named something the row has no
        -- field for, and returning nothing because the element declares no fields,
        -- read the same, and the second is a fact while the first is a mistake.

    @invariant StagesAreClosed
        -- A query is a root followed by a pipeline of stages applied left to
        -- right over a collection. The stages are exactly: follow (a relation
        -- step, named by its target kind - see RelationVocabulary), where (a
        -- filter, with comparator = as equals, != as not_equals, ~ as matches,
        -- in as in_set), order (by a field, ascending, or descending when the
        -- field is named as descending), select (a field list), count, limit N,
        -- and distinct. No other stage exists.
        -- count is TERMINAL: it collapses the whole result to a scalar, so a
        -- pipeline with any stage after it is rejected rather than silently
        -- discarding the stages it can no longer apply.
        -- The textual surface is fixed too, so it cannot drift from the
        -- specification; the engine accepts exactly these spellings:
        --   root       kind | kind:id | kind:name - the kind singular or plural
        --              (element = elements), the id an integer, the name the rest
        --              of the token (quoting optional)
        --   separator  | between the root and each stage, and between stages
        --   follow     relation {projection}?, the projection naming edge fields
        --              or being empty / {*} for the whole edge record
        --   where      field = | != | ~ | in value - ~ a regular expression, in a
        --              comma-separated set, which may be parenthesised
        --   order      field, or -field for descending
        --   select     field,field
        --   count, distinct, limit N
        -- The keyword tokens - a root's kind, a relation, the stage words where,
        -- order, select, count, distinct and limit, and the comparator word in -
        -- are matched case-insensitively, while a field name keeps its case. A
        -- where comparison folds both sides for =, != and in, while ~ matches its
        -- regular expression against the raw text, so its case sensitivity is the
        -- pattern's own.

    @invariant ResultsAreBoundedByQuestion
        -- What comes back scales with the question asked, not the size of the
        -- model. Each row carries the landed entity's identity (id and kind), its
        -- name or title, and enough location breadcrumb to distinguish
        -- same-named siblings, plus the projected edge when one was requested.
        -- select narrows a row to the named fields - always within the closed set
        -- ProjectableFieldsAreClosed states, never the whole entity record; count
        -- collapses the whole result to a scalar. Exploring a model of thousands
        -- of entities with a handful of stages returns a handful of rows.

    @invariant ReadOnly
        -- A query never mutates the model: no rule fires, nothing is created,
        -- renamed, reordered or deleted, and no change-stream delta is emitted.

    @invariant UnknownStepRejected
        -- A root or follow stage that names no valid kind or relation is
        -- rejected rather than silently ignored. A token that names no relation
        -- at all is rejected naming the accepted kinds and directions; a
        -- relation that exists but is not reachable from the current kind is
        -- rejected naming the alternatives available from that kind. Either way
        -- a caller (human or LLM) can correct itself from the error.

    @invariant NameRootsDelegateToNameResolution
        -- A name-based root is resolved by NameResolution; this contract adds no
        -- name matching of its own, so resolve's tiers, candidate cap and
        -- tie-breaking remain the single source of name behaviour.

    @guidance
        -- The query language is the relational counterpart to NameResolution:
        -- resolve answers "which entity is this name?", query answers "what is
        -- related to this / what does this reach?". Neither operation dumps the
        -- model. Free-text / semantic questions ("the event that fires when
        -- checkout completes") remain the caller's job, exactly as for resolve.
}

-- ---------------------------------------------------------------------------
-- Authoring surface (the operator's boundary)
-- ---------------------------------------------------------------------------

-- Reached by a local single operator through a command-line client, which is a
-- thin front end over these operations and the exposes projection below; the
-- boundary and the client are separate concerns (see the scope note on
-- delivery).
surface ModelAuthoring {
    -- No facing actor: a local CLI has a single operator with no modelled
    -- identity or auth. The surface is scoped to one model at a time.
    context model: EventModel

    exposes:
        model.name

        for t in model.timelines:
            t.title
            for s in t.slices:
                s.title
                s.slice_type
                s.status
                s.index
                s.is_complete
                s.timeline.title
                for p in s.placements:
                    p.index
                    p.element.name
                for e in s.events:
                    e.element.name
                for sc in s.screens:
                    sc.element.name
                for spec in s.specifications:
                    spec.title
                    spec.is_complete
                    for st in spec.steps:
                        st.clause
                        st.index
                        st.is_error
                        st.error_name
                        -- Which element this step is about; an error step refers to no element.
                        st.element.name
                        st.spec.title
                        for ex in st.examples:
                            ex.field_name
                            ex.field_value

        for sw in model.swimlanes:
            sw.name
            sw.index

        for el in model.elements:
            el.name
            el.element_type
            -- Which swimlane row this element is assigned to (absent if
            -- unassigned), so the UI can group elements by lane.
            el.swimlane
            -- Whether every field on this element is sourced (carried, derived
            -- or introduced); drives the completeness affordance in the UI.
            el.is_information_complete
            -- A screen's layout tree (absent until it has one), so an operator
            -- or an agent can read the tree and its node ids before editing it.
            el.wireframe

        for c in model.connections:
            c.from.name
            c.to.name

    provides:
        -- Timelines
        CreateTimeline(model, title, id?)
        RenameTimeline(timeline, new_title)
        DeleteTimeline(timeline)

        -- Swimlanes
        CreateSwimlane(model, name, index, id?)
        RenameSwimlane(lane, new_name)
        ReorderSwimlane(lane, new_index)
        DeleteSwimlane(lane)

        -- Slices
        AddSlice(timeline, title, slice_type, index, id?)
        RenameSlice(slice, new_title)
        ReorderSlice(slice, new_index)
        SetSliceStatus(slice, new_status)
        SetSliceType(slice, new_slice_type)
        DeleteSlice(slice)

        -- Elements
        CreateElement(model, name, element_type, id?)
        AddField(element, field, parent_field?)
        RemoveField(element, name)
        RenameField(element, name, new_name)
        SetElementContext(element, new_context)
        AssignSwimlane(element, lane)
        SetImageUrl(element, url)
        AddFieldOrigin(element, field, origin)
        RemoveFieldOrigin(element, field)
        RenameElement(element, new_name)
        DeleteElement(element)

        -- Screen layouts (a screen's layout tree, edited node by node)
        AddWireframeNode(screen, tag, attributes, parent?, text?)
        AddWireframeNodeBefore(screen, sibling, tag, attributes, text?)
        SetWireframeAttr(screen, node, attribute, value)
        SetWireframeText(screen, node, text)
        DeleteWireframeNode(screen, node)

        -- Placements
        PlaceElement(slice, element, id?)
        ReorderPlacement(slice, element, move)
        RemovePlacement(slice, element)

        -- Connections (a command is triggered only via a screen -> command or
        -- automation -> command connection)
        Connect(from, to, id?)
        Disconnect(connection)
        AddDerivation(connection, target_field, source_fields)
        RemoveDerivation(connection, target_field)

        -- Specifications (Given / When / Then)
        AddSpecification(slice, title, id?)
        RenameSpecification(spec, new_title)
        DeleteSpecification(spec)
        AddSpecStep(spec, clause, element, index, id?)
        AddErrorStep(spec, error_name, index, id?)
        RenameErrorStep(step, new_error_name)
        RemoveSpecStep(step)
        AddStepExample(step, field_name, field_value)
        RemoveStepExample(step, field_name)
        SetStepExpectEmpty(step, value)

    contracts:
        fulfils SchemaCodec
        fulfils NameResolution
        fulfils ModelQuery

    @guidance
        -- A ValidateModel operation (report slices that are not is_complete,
        -- specifications that are not Specification.is_complete - the same check
        -- the export gate makes, so an operator learns what would refuse an
        -- export before attempting one - elements that are not
        -- is_information_complete, and any derivation whose
        -- target_field or source_fields reference a field name that does not
        -- exist on the relevant element - an orphaned derivation that silently
        -- fails to source its target), the SchemaCodec import/export operations,
        -- and the NameResolution.resolve query are also invoked through this
        -- surface (none of them being plain mutating provides: rules):
        -- import/export are governed by the SchemaCodec contract, name
        -- resolution by the NameResolution contract, and structural exploration
        -- (following relations outward from a root) by the ModelQuery contract. Reading a screen's layout as
        -- an addressed tree - so an operator can see which node ids exist before
        -- editing one - is a read of the exposes projection above, not an
        -- operation.
        --
        -- The optional `id` on the entity-creating operations is the pre-assigned
        -- identity described with the rules: identity is unique across every
        -- entity of a model, so an id already in use is rejected rather than
        -- colliding. Operations themselves address entities by identity, not by
        -- name; turning a name into an identity is NameResolution's job.
        --
        -- No operation is provided for the model itself. Its existence and its
        -- name are given as the process starts, and it is never renamed: the
        -- surface is scoped to one model for its lifetime.
}

-- ---------------------------------------------------------------------------
-- Change stream surface (the frontend visualisation boundary)
-- ---------------------------------------------------------------------------

-- One surface instance per connected client. The client receives the canonical
-- model (snapshot then deltas) and can only disconnect; it never edits here.
surface ModelChangeStream {
    context subscription: Subscription

    exposes:
        -- The canonical model the client visualises, streamed as snapshot+deltas.
        subscription.model.name
        -- The model's whole element registry, which a snapshot carries so that
        -- every element id a later delta names is resolved by the seed or by an
        -- earlier delta (see the @guidance below). Each entry is the canonical
        -- element record a delta `entity` carries -- identity, ownership and
        -- provenance included; the fields listed here are the ones a consumer
        -- displays.
        for el in subscription.model.elements:
            el.name
            el.element_type
            el.context
            el.swimlane
            el.is_information_complete
            el.image_url
            el.wireframe
            -- The element's own field shapes. Each field's `subfields` nest the
            -- same shape at every depth, so this list states one level of it.
            for f in el.fields:
                f.name
                f.type
                f.optional
                f.cardinality
        for t in subscription.model.timelines:
            t.title
            for s in t.slices:
                s.title
                s.slice_type
                s.status
                s.index
                s.is_complete
                for p in s.placements:
                    p.index
                    p.element.name
                    p.element.element_type
                    -- Which swimlane row this element is assigned to (absent if
                    -- unassigned), so the frontend can group elements by lane.
                    p.element.swimlane
                    -- Per-element completeness, so the frontend can render which
                    -- elements still have unsourced fields.
                    p.element.is_information_complete
                    -- A screen's external mockup reference (absent unless one was
                    -- set), for a frontend that shows a mockup instead of, or
                    -- alongside, the layout tree.
                    p.element.image_url
                    -- A screen's layout tree (absent until it has one), so the
                    -- frontend can draw the screen as the author described it.
                    p.element.wireframe
                    -- Field shape only (name/type/optional/cardinality) in this
                    -- nested projection, so the frontend can render an element's
                    -- fields directly on the canvas. The recursive shape
                    -- (subfields included) travels in the element's canonical
                    -- record -- the model's `elements` registry entry, or a delta
                    -- `entity` -- not here.
                    for f in p.element.fields:
                        f.name
                        f.type
                        f.optional
                        f.cardinality
                for spec in s.specifications:
                    spec.title
                    spec.is_complete
                    for st in spec.steps:
                        st.clause
                        st.index
                        st.is_error
                        st.error_name
                        -- Which element this step is about; an error step refers to no element.
                        st.element.name
                        for ex in st.examples:
                            ex.field_name
                            ex.field_value
        for sw in subscription.model.swimlanes:
            sw.name
            -- Author-controlled order, so the frontend stacks swimlanes correctly.
            sw.index
        for c in subscription.model.connections:
            c.from.name
            c.to.name
            -- Connection-local provenance, so the frontend can render how fields
            -- flow along each wiring.
            for d in c.derivations:
                d.target_field
                d.source_fields

    provides:
        Subscribe(model)
        Unsubscribe(subscription)

    contracts:
        fulfils ChangeStream

    @guidance
        -- Transport is an SSE server over HTTP (one event stream per connected
        -- client); a WebSocket would satisfy the same contract. Subscribe opens
        -- the stream and triggers the initial snapshot; the server then pushes a
        -- delta per committed authoring mutation. This boundary is outbound only.
        --
        -- Identity is what ties the two messages together: every entity in a
        -- snapshot and every entity in a delta carries the same identity, so a
        -- consumer seeds its state from the snapshot and patches it by identity
        -- as deltas arrive. The snapshot carries the model's whole element
        -- registry, each element in the canonical record shape the deltas use,
        -- so element identity is reachable from the seed alone: a delta that
        -- names an element which existed when the snapshot was taken resolves
        -- for a consumer that has seen nothing but its snapshot, and one that
        -- names an element created afterwards resolves through the delta that
        -- created it, delivered in commit order before the reference. A
        -- placement, a connection and a specification step nest a reduced
        -- display projection of the element they refer to -- a placement the
        -- element's name, element_type, swimlane, is_information_complete, image_url,
        -- wireframe and its field shapes; a connection end and a specification
        -- step its name alone (the exposes list above is the detailed statement)
        -- -- which is not a substitute for the registry: an element that is
        -- neither placed nor wired is in no nested entry at all, and a consumer
        -- subscribing after that element was created never receives the delta
        -- that created it either, because that delta was emitted before the
        -- subscription opened and nothing is replayed. A snapshot also carries
        -- the same identity for entities the interchange format has no place for
        -- (timelines, swimlanes), which is why the stream, not the export, is
        -- what a live visualiser consumes.
        --
        -- The same snapshot shape is also served on a one-shot read, for a client
        -- that wants the current model without holding a stream open, with a
        -- health check beside it. Both are delivery, not behaviour.
}

-- ---------------------------------------------------------------------------
-- Open questions
-- ---------------------------------------------------------------------------

-- Schema mapping & round-trip fidelity decisions are documented on the
-- SchemaCodec contract above.

open question "NameResolution.NameQuery.kind_hint currently records only the resolvable entity kind (Timeline/Swimlane/Slice/Element/Specification). Should it also carry a finer sub-kind hint (Element.element_type: command/event/read_model/screen/automation, or Slice.slice_type: state_change/state_view/automation) to further rank candidates? Those are inline enums on Element/Slice today; supporting them as hint fields requires promoting them to named enums (a change to existing entities) or a parallel named enum duplicating their literals. Deferred pending a decision on whether the extra ranking signal is worth that."

open question "A dependency or a specification step naming an element the document does not embed - an element the model holds with no placement anywhere - is dropped on import, together with the connection or step that named it (see the dropped-fields guidance). Should import instead reinstate the element from the reference itself? A dependency carries the target's groupId, title and elementType, and a step its title and type, so the element could be recreated with that name and element type - no fields, no context, no swimlane, which is all the document states about it - and the connection or step would survive the round-trip. The alternative, taken here, keeps import from inventing element state the document does not carry and records the loss instead. Which loss is worse is a judgement about how far the placement-bound projection should reach."

