{
  "_instructions" : "Run `emcli show` to read entity ids required by authoring commands, or `emcli resolve` to look up ids by name (e.g. from an LLM's conversational context) without pulling the whole model. Pass flags as --flag value.",
  "commands" : {
    "resolve" : {
      "params" : [ {
        "flag" : "queries",
        "type" : "string",
        "required" : true,
        "note" : "comma-separated name[:kind_hint] entries, e.g. \"Baz:slice,Snaz\"; kind_hint is one of timeline|swimlane|slice|element|specification and only ranks candidates, never filters them"
      } ]
    }
  },
  "groups" : {
    "connection" : {
      "add" : {
        "params" : [ {
          "flag" : "from",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        }, {
          "flag" : "to",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        }, {
          "flag" : "id",
          "type" : "int",
          "required" : false,
          "note" : "pre-assign this entity's id instead of auto-generating one; must not already be in use"
        } ]
      },
      "add-derivation" : {
        "params" : [ {
          "flag" : "connection",
          "type" : "int",
          "required" : true,
          "ref" : "connections[].id"
        }, {
          "flag" : "target",
          "type" : "string",
          "required" : true,
          "note" : "target field name on the to-element"
        }, {
          "flag" : "from",
          "type" : "string",
          "required" : true,
          "note" : "comma-separated source field names from the from-element"
        } ]
      },
      "remove" : {
        "params" : [ {
          "flag" : "connection",
          "type" : "int",
          "required" : true,
          "ref" : "connections[].id"
        } ]
      },
      "remove-derivation" : {
        "params" : [ {
          "flag" : "connection",
          "type" : "int",
          "required" : true,
          "ref" : "connections[].id"
        }, {
          "flag" : "target",
          "type" : "string",
          "required" : true,
          "note" : "target field name to remove the derivation for"
        } ]
      }
    },
    "element" : {
      "add" : {
        "params" : [ {
          "flag" : "name",
          "type" : "string",
          "required" : true
        }, {
          "flag" : "kind",
          "type" : "keyword",
          "required" : true,
          "values" : [ "command", "event", "read_model", "screen", "automation" ]
        }, {
          "flag" : "id",
          "type" : "int",
          "required" : false,
          "note" : "pre-assign this entity's id instead of auto-generating one; must not already be in use"
        } ]
      },
      "add-field" : {
        "params" : [ {
          "flag" : "element",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        }, {
          "flag" : "field-json",
          "type" : "json",
          "required" : true,
          "note" : "JSON field object, e.g. {\"name\":\"orderId\",\"type\":\"string\"}; replaces any existing field of the same name"
        } ]
      },
      "add-origin" : {
        "params" : [ {
          "flag" : "element",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        }, {
          "flag" : "field",
          "type" : "string",
          "required" : true,
          "note" : "field name on the element"
        }, {
          "flag" : "origin",
          "type" : "keyword",
          "required" : true,
          "note" : "how the field is introduced: user_input, generated, external"
        } ]
      },
      "context" : {
        "params" : [ {
          "flag" : "element",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        }, {
          "flag" : "new-context",
          "type" : "keyword",
          "required" : true
        } ]
      },
      "delete" : {
        "params" : [ {
          "flag" : "element",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        } ]
      },
      "image" : {
        "params" : [ {
          "flag" : "element",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        }, {
          "flag" : "url",
          "type" : "string",
          "required" : true
        } ]
      },
      "remove-field" : {
        "params" : [ {
          "flag" : "element",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        }, {
          "flag" : "name",
          "type" : "string",
          "required" : true,
          "note" : "field name to remove"
        } ]
      },
      "remove-origin" : {
        "params" : [ {
          "flag" : "element",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        }, {
          "flag" : "field",
          "type" : "string",
          "required" : true,
          "note" : "field name whose origin override should be removed"
        } ]
      },
      "rename" : {
        "params" : [ {
          "flag" : "element",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        }, {
          "flag" : "new-name",
          "type" : "string",
          "required" : true
        } ]
      },
      "swimlane" : {
        "params" : [ {
          "flag" : "element",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        }, {
          "flag" : "lane",
          "type" : "int",
          "required" : true,
          "ref" : "swimlanes[].id"
        } ]
      }
    },
    "placement" : {
      "add" : {
        "params" : [ {
          "flag" : "slice",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].id"
        }, {
          "flag" : "element",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        }, {
          "flag" : "id",
          "type" : "int",
          "required" : false,
          "note" : "pre-assign this entity's id instead of auto-generating one; must not already be in use"
        } ]
      },
      "remove" : {
        "params" : [ {
          "flag" : "placement",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].placements[].id"
        } ]
      },
      "reorder" : {
        "params" : [ {
          "flag" : "placement",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].placements[].id"
        }, {
          "flag" : "new-index",
          "type" : "int",
          "required" : true
        } ]
      }
    },
    "slice" : {
      "add" : {
        "params" : [ {
          "flag" : "timeline",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].id"
        }, {
          "flag" : "title",
          "type" : "string",
          "required" : true
        }, {
          "flag" : "kind",
          "type" : "keyword",
          "required" : true,
          "values" : [ "state_change", "state_view", "automation" ]
        }, {
          "flag" : "index",
          "type" : "int",
          "required" : true
        }, {
          "flag" : "id",
          "type" : "int",
          "required" : false,
          "note" : "pre-assign this entity's id instead of auto-generating one; must not already be in use"
        } ]
      },
      "delete" : {
        "params" : [ {
          "flag" : "slice",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].id"
        } ]
      },
      "kind" : {
        "params" : [ {
          "flag" : "slice",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].id"
        }, {
          "flag" : "new-kind",
          "type" : "keyword",
          "required" : true,
          "values" : [ "state_change", "state_view", "automation" ]
        } ]
      },
      "reorder" : {
        "params" : [ {
          "flag" : "slice",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].id"
        }, {
          "flag" : "new-index",
          "type" : "int",
          "required" : true
        } ]
      },
      "status" : {
        "params" : [ {
          "flag" : "slice",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].id"
        }, {
          "flag" : "new-status",
          "type" : "keyword",
          "required" : true,
          "values" : [ "created", "in_progress", "done", "informational" ]
        } ]
      }
    },
    "spec" : {
      "add" : {
        "params" : [ {
          "flag" : "slice",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].id"
        }, {
          "flag" : "title",
          "type" : "string",
          "required" : true
        }, {
          "flag" : "id",
          "type" : "int",
          "required" : false,
          "note" : "pre-assign this entity's id instead of auto-generating one; must not already be in use"
        } ]
      },
      "delete" : {
        "params" : [ {
          "flag" : "spec",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].specifications[].id"
        } ]
      }
    },
    "step" : {
      "add" : {
        "params" : [ {
          "flag" : "spec",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].specifications[].id"
        }, {
          "flag" : "clause",
          "type" : "keyword",
          "required" : true,
          "values" : [ "given_step", "when_step", "then_step" ]
        }, {
          "flag" : "element",
          "type" : "int",
          "required" : true,
          "ref" : "elements[].id"
        }, {
          "flag" : "index",
          "type" : "int",
          "required" : true
        }, {
          "flag" : "id",
          "type" : "int",
          "required" : false,
          "note" : "pre-assign this entity's id instead of auto-generating one; must not already be in use"
        } ]
      },
      "add-example" : {
        "params" : [ {
          "flag" : "step",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].specifications[].steps[].id"
        }, {
          "flag" : "field-name",
          "type" : "string",
          "required" : true,
          "note" : "example field name; replaces any existing example for the same field"
        }, {
          "flag" : "field-value",
          "type" : "string",
          "required" : true
        } ]
      },
      "error" : {
        "params" : [ {
          "flag" : "spec",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].specifications[].id"
        }, {
          "flag" : "error-name",
          "type" : "string",
          "required" : true
        }, {
          "flag" : "index",
          "type" : "int",
          "required" : true
        }, {
          "flag" : "id",
          "type" : "int",
          "required" : false,
          "note" : "pre-assign this entity's id instead of auto-generating one; must not already be in use"
        } ]
      },
      "expect-empty" : {
        "params" : [ {
          "flag" : "step",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].specifications[].steps[].id"
        }, {
          "flag" : "value",
          "type" : "boolean",
          "required" : true
        } ]
      },
      "remove" : {
        "params" : [ {
          "flag" : "step",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].specifications[].steps[].id"
        } ]
      },
      "remove-example" : {
        "params" : [ {
          "flag" : "step",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].slices[].specifications[].steps[].id"
        }, {
          "flag" : "field-name",
          "type" : "string",
          "required" : true,
          "note" : "example field name to remove"
        } ]
      }
    },
    "swimlane" : {
      "add" : {
        "params" : [ {
          "flag" : "name",
          "type" : "string",
          "required" : true
        }, {
          "flag" : "index",
          "type" : "int",
          "required" : true
        }, {
          "flag" : "id",
          "type" : "int",
          "required" : false,
          "note" : "pre-assign this entity's id instead of auto-generating one; must not already be in use"
        } ]
      },
      "delete" : {
        "params" : [ {
          "flag" : "lane",
          "type" : "int",
          "required" : true,
          "ref" : "swimlanes[].id"
        } ]
      },
      "rename" : {
        "params" : [ {
          "flag" : "lane",
          "type" : "int",
          "required" : true,
          "ref" : "swimlanes[].id"
        }, {
          "flag" : "new-name",
          "type" : "string",
          "required" : true
        } ]
      },
      "reorder" : {
        "params" : [ {
          "flag" : "lane",
          "type" : "int",
          "required" : true,
          "ref" : "swimlanes[].id"
        }, {
          "flag" : "new-index",
          "type" : "int",
          "required" : true
        } ]
      }
    },
    "timeline" : {
      "add" : {
        "params" : [ {
          "flag" : "title",
          "type" : "string",
          "required" : true
        }, {
          "flag" : "id",
          "type" : "int",
          "required" : false,
          "note" : "pre-assign this entity's id instead of auto-generating one; must not already be in use"
        } ]
      },
      "delete" : {
        "params" : [ {
          "flag" : "timeline",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].id"
        } ]
      },
      "rename" : {
        "params" : [ {
          "flag" : "timeline",
          "type" : "int",
          "required" : true,
          "ref" : "timelines[].id"
        }, {
          "flag" : "new-title",
          "type" : "string",
          "required" : true
        } ]
      }
    }
  }
}
