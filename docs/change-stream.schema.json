{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/emcli/event-model/docs/change-stream.schema.json",
  "title": "emcli ModelChangeStream SSE event",
  "description": "Schema for the JSON carried in the `data:` field of each Server-Sent Event on GET /stream. The first event is always a Snapshot; every subsequent event is a Delta. The SSE `event:` line equals the payload's `op` field (\"snapshot\" for the snapshot, the rule name for deltas). GET /snapshot returns a bare SnapshotEvent (same payload, no SSE framing).",
  "oneOf": [
    { "$ref": "#/$defs/SnapshotEvent" },
    { "$ref": "#/$defs/DeltaEvent" }
  ],
  "$defs": {
    "SnapshotEvent": {
      "type": "object",
      "description": "The full canonical model, sent once when a client connects (SnapshotThenDeltas). Every entity carries its integer `id` (the same surrogate identity the deltas use), so a consumer can seed a normalised store from the snapshot and patch it by id from later deltas. Denormalised display fields (element/connection names) are nested under their sub-entity, which also carries its id.",
      "required": ["op", "model"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "snapshot" },
        "model": {
          "type": "object",
          "required": ["id", "name", "timelines", "swimlanes", "connections"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "integer", "description": "EventModel id" },
            "name": { "type": "string" },
            "timelines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "slices"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "integer", "description": "Timeline id" },
                  "title": { "type": "string" },
                  "slices": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "title", "kind", "status", "index", "placements"],
                      "additionalProperties": false,
                      "properties": {
                        "id": { "type": "integer", "description": "Slice id" },
                        "title": { "type": "string" },
                        "kind": { "$ref": "#/$defs/sliceKind" },
                        "status": { "$ref": "#/$defs/sliceStatus" },
                        "index": { "type": "integer" },
                        "placements": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["id", "element"],
                            "additionalProperties": false,
                            "properties": {
                              "id": { "type": "integer", "description": "ElementPlacement id" },
                              "element": {
                                "type": "object",
                                "required": ["id", "name", "kind", "is_information_complete", "fields"],
                                "additionalProperties": false,
                                "properties": {
                                  "id": { "type": "integer", "description": "Element id (correlates with element deltas)" },
                                  "name": { "type": "string" },
                                  "kind": { "$ref": "#/$defs/elementKind" },
                                  "swimlane": { "type": ["integer", "null"], "description": "Swimlane id, or null if unassigned." },
                                  "is_information_complete": {
                                    "type": "boolean",
                                    "description": "True iff every field on the element is sourced (carried, derived or introduced)."
                                  },
                                  "image_url": {
                                    "type": ["string", "null"],
                                    "description": "Reference image URL for screen elements; null until SetImageUrl is invoked."
                                  },
                                  "wireframe": {
                                    "oneOf": [
                                      { "$ref": "#/$defs/WireframeNode" },
                                      { "type": "null" }
                                    ],
                                    "description": "Hiccup-like wireframe tree; null until AddWireframeNode is invoked on a screen element."
                                  },
                                  "fields": {
                                    "type": "array",
                                    "description": "Shape only (subfields are not streamed here); see SnapshotField.",
                                    "items": { "$ref": "#/$defs/SnapshotField" }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "swimlanes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "integer", "description": "Swimlane id" },
                  "name": { "type": "string" }
                }
              }
            },
            "connections": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "integer", "description": "Connection id" },
                  "from": { "$ref": "#/$defs/connectionEnd", "description": "source element" },
                  "to": { "$ref": "#/$defs/connectionEnd", "description": "target element" },
                  "derivations": {
                    "type": "array",
                    "description": "Connection-local field provenance: how named target fields are derived from source fields.",
                    "items": {
                      "type": "object",
                      "required": ["target_field", "source_fields"],
                      "additionalProperties": false,
                      "properties": {
                        "target_field": { "type": "string" },
                        "source_fields": { "type": "array", "items": { "type": "string" } }
                      }
                    }
                  }
                },
                "required": ["id", "from", "to", "derivations"]
              }
            }
          }
        }
      }
    },

    "connectionEnd": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "description": "Element id" },
        "name": { "type": "string" }
      }
    },

    "DeltaEvent": {
      "type": "object",
      "description": "One delta per committed authoring mutation (DeltaPerMutation), delivered in commit order. Carries id-keyed, normalised canonical entities with integer foreign-key references. A cascading delete is a single delta whose `changes` lists every removed entity.",
      "required": ["op", "changes"],
      "additionalProperties": false,
      "properties": {
        "op": { "$ref": "#/$defs/deltaOp" },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/Change" }
        }
      }
    },

    "Change": {
      "oneOf": [
        {
          "type": "object",
          "description": "An entity was created or updated; `entity` is its full new canonical state.",
          "required": ["action", "type", "id", "entity"],
          "additionalProperties": false,
          "properties": {
            "action": { "enum": ["created", "updated"] },
            "type": { "$ref": "#/$defs/entityType" },
            "id": { "type": "integer" },
            "entity": { "$ref": "#/$defs/Entity" }
          }
        },
        {
          "type": "object",
          "description": "An entity was removed. No `entity` payload is sent for deletions.",
          "required": ["action", "type", "id"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "deleted" },
            "type": { "$ref": "#/$defs/entityType" },
            "id": { "type": "integer" }
          }
        }
      ]
    },

    "Entity": {
      "description": "A canonical store entity. The variant is discriminated by `type`. All entities carry an integer `id` and `type`; relationships are integer foreign-key ids.",
      "oneOf": [
        { "$ref": "#/$defs/Timeline" },
        { "$ref": "#/$defs/Swimlane" },
        { "$ref": "#/$defs/Slice" },
        { "$ref": "#/$defs/Element" },
        { "$ref": "#/$defs/Placement" },
        { "$ref": "#/$defs/Connection" },
        { "$ref": "#/$defs/Specification" },
        { "$ref": "#/$defs/SpecStep" }
      ]
    },

    "Timeline": {
      "type": "object",
      "required": ["id", "type", "model", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "type": { "const": "timeline" },
        "model": { "type": "integer", "description": "owning EventModel id" },
        "title": { "type": "string" }
      }
    },
    "Swimlane": {
      "type": "object",
      "required": ["id", "type", "model", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "type": { "const": "swimlane" },
        "model": { "type": "integer" },
        "name": { "type": "string" }
      }
    },
    "Slice": {
      "type": "object",
      "required": ["id", "type", "timeline", "title", "kind", "index", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "type": { "const": "slice" },
        "timeline": { "type": "integer", "description": "owning Timeline id" },
        "title": { "type": "string" },
        "kind": { "$ref": "#/$defs/sliceKind" },
        "index": { "type": "integer" },
        "status": { "$ref": "#/$defs/sliceStatus" }
      }
    },
    "Element": {
      "type": "object",
      "required": ["id", "type", "model", "name", "kind", "context", "fields"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "type": { "const": "element" },
        "model": { "type": "integer" },
        "name": { "type": "string" },
        "kind": { "$ref": "#/$defs/elementKind" },
        "context": { "$ref": "#/$defs/elementContext" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/Field" } },
        "swimlane": {
          "type": ["integer", "null"],
          "description": "assigned Swimlane id; absent until AssignSwimlane is invoked"
        },
        "image_url": {
          "type": "string",
          "description": "wireframe URL for screen elements; absent until SetImageUrl is invoked"
        },
        "field_origins": {
          "type": "array",
          "description": "operator overrides marking fields that are legitimately introduced here",
          "items": { "$ref": "#/$defs/FieldOrigin" }
        },
        "wireframe": {
          "$ref": "#/$defs/WireframeNode",
          "description": "hiccup-like wireframe tree; present only on screen elements that have one"
        }
      }
    },
    "Placement": {
      "type": "object",
      "required": ["id", "type", "slice", "element"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "type": { "const": "placement" },
        "slice": { "type": "integer" },
        "element": { "type": "integer" }
      }
    },
    "Connection": {
      "type": "object",
      "required": ["id", "type", "model", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "type": { "const": "connection" },
        "model": { "type": "integer" },
        "from": { "type": "integer", "description": "source Element id" },
        "to": { "type": "integer", "description": "target Element id" },
        "derivations": {
          "type": "array",
          "description": "connection-local field provenance",
          "items": { "$ref": "#/$defs/FieldDerivation" }
        }
      }
    },
    "Specification": {
      "type": "object",
      "required": ["id", "type", "slice", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "type": { "const": "specification" },
        "slice": { "type": "integer" },
        "title": { "type": "string" }
      }
    },
    "SpecStep": {
      "type": "object",
      "required": ["id", "type", "spec", "clause", "index", "is_error", "expect_empty", "examples"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer" },
        "type": { "const": "spec-step" },
        "spec": { "type": "integer", "description": "owning Specification id" },
        "clause": { "$ref": "#/$defs/clause" },
        "index": { "type": "integer" },
        "element": {
          "type": "integer",
          "description": "Element this step asserts about; absent on an error step (is_error=true)"
        },
        "is_error": { "type": "boolean" },
        "error_name": {
          "type": "string",
          "description": "present only when is_error=true"
        },
        "expect_empty": { "type": "boolean" },
        "examples": { "type": "array", "items": { "$ref": "#/$defs/Example" } }
      }
    },

    "Field": {
      "type": "object",
      "required": ["name", "type", "optional", "cardinality", "subfields"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/fieldType" },
        "optional": { "type": "boolean" },
        "cardinality": { "$ref": "#/$defs/fieldCardinality" },
        "subfields": { "type": "array", "items": { "$ref": "#/$defs/Field" } }
      }
    },

    "SnapshotField": {
      "description": "A field as streamed on a snapshot placement's element: shape only, no subfields. The full recursive Field shape (subfields included) travels only in delta entities.",
      "type": "object",
      "required": ["name", "type", "optional", "cardinality"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "type": { "$ref": "#/$defs/fieldType" },
        "optional": { "type": "boolean" },
        "cardinality": { "$ref": "#/$defs/fieldCardinality" }
      }
    },
    "Example": {
      "type": "object",
      "required": ["field_name", "field_value"],
      "additionalProperties": false,
      "properties": {
        "field_name": { "type": "string" },
        "field_value": { "type": "string" }
      }
    },
    "FieldDerivation": {
      "type": "object",
      "description": "Connection-local provenance: a target field derived from one or more source fields (one with a different name = rename; many = aggregation).",
      "required": ["target_field", "source_fields"],
      "additionalProperties": false,
      "properties": {
        "target_field": { "type": "string", "description": "field on the connection's `to` element" },
        "source_fields": { "type": "array", "items": { "type": "string" }, "description": "field(s) on the `from` element it derives from" }
      }
    },
    "FieldOrigin": {
      "type": "object",
      "description": "Override declaring a field is legitimately introduced rather than sourced upstream.",
      "required": ["field", "origin"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string" },
        "origin": { "enum": ["user_input", "generated", "external"] }
      }
    },

    "WireframeNode": {
      "type": "array",
      "description": "A wireframe node in hiccup-like form: [tag, attrs, ...children]. Cheshire serialises Clojure keywords as strings, so the Clojure vector `[:button {:label \"OK\" :-id \"n2\"}]` arrives on the wire as `[\"button\", {\"-id\": \"n2\", \"label\": \"OK\"}]`. The root node is always `\"screen\"`. The attrs object always contains `\"-id\"` (a stable string address used for incremental edits); other attrs are tag-specific. Children are either nested WireframeNodes or plain strings (for text-children tags such as h1, h2, h3).",
      "minItems": 1,
      "prefixItems": [
        { "type": "string", "description": "tag name (e.g. \"screen\", \"button\", \"input\")" },
        {
          "type": "object",
          "description": "node attributes; always contains \"-id\"",
          "required": ["-id"],
          "properties": {
            "-id": { "type": "string", "description": "stable node address for incremental edits" }
          },
          "additionalProperties": { "type": ["string", "boolean", "number"] }
        }
      ],
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/WireframeNode" },
          { "type": "string", "description": "text child (only on text-children tags: h1, h2, h3, text, span)" }
        ]
      }
    },

    "entityType": {
      "enum": ["timeline", "swimlane", "slice", "element", "placement",
               "connection", "specification", "spec-step"]
    },
    "sliceKind": { "enum": ["state_change", "state_view", "automation"] },
    "sliceStatus": { "enum": ["created", "in_progress", "done", "informational"] },
    "elementKind": { "enum": ["command", "event", "read_model", "screen", "automation"] },
    "elementContext": { "enum": ["internal", "external"] },
    "clause": { "enum": ["given_step", "when_step", "then_step"] },
    "fieldType": {
      "enum": ["string", "boolean", "double", "decimal", "long", "custom",
               "date", "date_time", "uuid", "int"]
    },
    "fieldCardinality": { "enum": ["single", "list"] },
    "deltaOp": {
      "description": "The authoring operation that produced the delta (also the SSE event name).",
      "enum": [
        "CreateTimeline", "RenameTimeline", "DeleteTimeline",
        "CreateSwimlane", "RenameSwimlane", "DeleteSwimlane",
        "AddSlice", "ReorderSlice", "SetSliceStatus", "SetSliceKind", "DeleteSlice",
        "CreateElement", "SetFields", "SetElementContext", "AssignSwimlane",
        "SetImageUrl", "SetFieldOrigins", "RenameElement", "DeleteElement",
        "PlaceElement", "RemovePlacement",
        "Connect", "Disconnect", "SetConnectionDerivations",
        "AddSpecification", "DeleteSpecification",
        "AddSpecStep", "AddErrorStep", "RemoveSpecStep",
        "SetStepExamples", "SetStepExpectEmpty",
        "AddWireframeNode", "SetWireframeAttr", "DeleteWireframeNode"
      ]
    }
  }
}
