{:paths ["src" "test"]
 :deps {http-kit/http-kit {:mvn/version "2.8.0"}}
 :bbin/bin {emcli {:main-opts ["-m" "emcli.cli"]}}
 :tasks
 {check {:doc      "Check the code and docs against docs/change-stream.schema.json"
         :task     (exec 'emcli.change-stream-check/run)
         :requires ([emcli.change-stream-check])}
  test {:doc      "Run the test suite (after the change-stream drift check)"
        :depends  [check]
        :task     (exec 'emcli.test-runner/run)
        :requires ([emcli.test-runner])}
  run  {:doc              "Run the emcli CLI"
        :override-builtin true
        :requires         ([emcli.cli])
        :task             (emcli.cli/-main)}}}
